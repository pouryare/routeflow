# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime database and uploaded photos (generated, not source -- real customer/business data)
/data/coverage.db*
/data/photos/*

# local database/photo backups (see scripts/backup.mjs) -- these belong on a
# separate disk/host to protect against this machine's own failure, not in git
/backups/
# a database backup left anywhere under data/ is the same real customer data as the
# runtime db above -- ignore the path too, not just the canonical one, and not just the
# backups/ subdirectory. Five ad-hoc backup-*.db snapshots slipped into a commit before
# this line existed (see git log) precisely because the old pattern only caught the one
# blessed location -- this one catches any .db file dropped anywhere under data/.
/data/backups/
/data/*.db*

# git worktrees created for feature work: a whole second checkout, node_modules and all
/.claude/worktrees/

# local memory-search index state -- per-machine tool cache, not project source
/.memsearch/

# raw cloned source repos used only to generate mahalle.geojson once
/data/tehran-map-src
/data/tehran-districts-src

.qa-shot.mjs
.qa-clip.mjs
