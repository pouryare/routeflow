{
  "name": "routeflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run && vitest run -c vitest.smoke.mts",
    "test:unit": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.mts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audit-copy": "node scripts/audit-copy.mjs",
    "seed:demo": "node --experimental-strip-types --no-warnings --import ./scripts/_ts-register.mjs scripts/seed-demo.ts",
    "seed:demo:reset": "npm run seed:demo -- --force",
    "dev:demo": "ROUTEFLOW_DB_PATH=./data/routeflow.demo.db next dev",
    "test:demo": "vitest run tests/seed-demo-deep.test.ts",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "check:mobile": "node scripts/check-mobile-rules.mjs",
    "check:architecture": "node scripts/check-architecture.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "perf:smoke": "bash scripts/perf/ci-smoke.sh",
    "db:pg:generate": "node --experimental-strip-types --no-warnings --import ./scripts/_ts-register.mjs scripts/pg/generate-baseline.ts",
    "db:pg:migrate": "node-pg-migrate up -m db/migrations",
    "db:pg:types": "kysely-codegen",
    "db:pg:lint": "squawk db/migrations/*.sql",
    "test:pg": "node scripts/pg/test-pg.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@types/leaflet-routing-machine": "^3.2.9",
    "@types/leaflet.markercluster": "^1.5.6",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.2.0",
    "kysely": "^0.29.7",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "leaflet-routing-machine": "^3.2.12",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "open-location-code": "^1.0.3",
    "pg": "^8.23.1",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "6.1.6",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tmcw/togeojson": "^7.1.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.0.1",
    "knip": "^6.42.1",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "squawk-cli": "^2.70.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
