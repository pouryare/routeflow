{
  "name": "routeflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run && vitest run -c vitest.smoke.mts",
    "test:unit": "vitest run",
    "test:smoke": "vitest run -c vitest.smoke.mts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audit-copy": "node scripts/audit-copy.mjs",
    "seed:demo": "node --experimental-strip-types --no-warnings --import ./scripts/_ts-register.mjs scripts/seed-demo.ts",
    "seed:demo:reset": "npm run seed:demo -- --force",
    "dev:demo": "ROUTEFLOW_DB_PATH=./data/routeflow.demo.db next dev",
    "test:demo": "vitest run tests/seed-demo-deep.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "perf:smoke": "bash scripts/perf/ci-smoke.sh"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@types/leaflet-routing-machine": "^3.2.9",
    "@types/leaflet.markercluster": "^1.5.6",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.2.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "leaflet-routing-machine": "^3.2.12",
    "leaflet.fullscreen": "^5.3.3",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "open-location-code": "^1.0.3",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tmcw/togeojson": "^7.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
