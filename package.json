{
  "name": "routeflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/pg/test-pg.mjs",
    "test:smoke": "vitest run -c vitest.smoke.mts",
    "check:contrast": "node scripts/check-contrast.mjs",
    "audit-copy": "node scripts/audit-copy.mjs",
    "seed:demo": "node --experimental-strip-types --no-warnings --import ./scripts/_ts-register.mjs scripts/seed-demo.ts",
    "seed:demo:reset": "npm run seed:demo -- --force",
    "dev:demo": "DATABASE_URL=${DEMO_DATABASE_URL:-postgres:///routeflow_demo?host=/var/run/postgresql} next dev",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "check:mobile": "node scripts/check-mobile-rules.mjs",
    "skeletons:capture": "node scripts/capture-skeletons.mjs",
    "check:architecture": "node scripts/check-architecture.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "perf:smoke": "bash scripts/perf/ci-smoke.sh",
    "db:pg:migrate": "node-pg-migrate up -m db/migrations",
    "db:pg:types": "kysely-codegen",
    "db:pg:lint": "squawk db/migrations/*.sql"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@protomaps/basemaps": "^5.7.2",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@vis.gl/react-maplibre": "^8.1.3",
    "canvas-confetti": "^1.9.4",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.2.0",
    "kysely": "^0.29.7",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.2",
    "open-location-code": "^1.0.3",
    "pg": "^8.23.1",
    "playwright": "^1.62.1",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "6.1.6",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "0.0.6",
    "web-push": "^3.6.7",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tmcw/togeojson": "^7.1.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@xmldom/xmldom": "^0.9.12",
    "boneyard-js": "^1.10.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.0.1",
    "knip": "^6.42.1",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "squawk-cli": "^2.70.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
