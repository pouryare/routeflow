# ---- O. Export with people's details replaced -------------------------------------------------------
# Same input -> same fake value, so duplicates and joins still show. Columns are picked by name.
# shortcut: by column name, not a reviewed list per table; add a pattern when a new personal column appears.
anonymise_sql() {
  cat <<'SQL'
-- A scratch copy: switch off the triggers (append-only logs, sync stamps) for this session.
SET session_replication_role = replica;
DO $$
DECLARE r record; expr text;
BEGIN
  FOR r IN
    SELECT c.table_name, c.column_name FROM information_schema.columns c
    JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name
    WHERE c.table_schema = 'public' AND t.table_type = 'BASE TABLE'
      AND c.data_type IN ('text', 'character varying')
      AND (c.column_name ~ '(phone|mobile|email|address|national_id|instagram|telegram|whatsapp|postal|iban|sheba|card_number|contact_name|owner_name|display_name|full_name|first_name|last_name|business_name|customer_name|^notes?$|_notes?$)'
           OR (c.column_name = 'name' AND c.table_name IN ('customers', 'contacts', 'suppliers', 'parties', 'shareholdings', 'representative_profiles')))
  LOOP
    expr := CASE
      WHEN r.column_name ~ '(phone|mobile|whatsapp)' THEN format('''09'' || lpad((abs(hashtext(%I)) %% 1000000000)::text, 9, ''0'')', r.column_name)
      WHEN r.column_name ~ 'email' THEN format('''u'' || left(md5(%I), 8) || ''@example.com''', r.column_name)
      WHEN r.column_name ~ '(iban|sheba|card_number|national_id|postal)' THEN format('lpad((abs(hashtext(%I)) %% 1000000000)::text, 10, ''0'')', r.column_name)
      ELSE format('''نمونه '' || left(md5(%I), 6)', r.column_name)
    END;
    EXECUTE format('UPDATE %I SET %I = %s WHERE %I IS NOT NULL AND %I <> ''''', r.table_name, r.column_name, expr, r.column_name, r.column_name);
  END LOOP;
END $$;
UPDATE users SET totp_secret = NULL, totp_last_step = NULL;
DELETE FROM user_recovery_codes;
SQL
}

