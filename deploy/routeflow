write_caddy() {
  # One file per site in $CADDY_DIR/sites/, all pulled in by one glob line, so adding another site
  # is a new file and this one is never touched. Global options stay in the Caddyfile.
  mkdir -p "$CADDY_DIR/sites"
  cat > "$CADDY_DIR/sites/routeflow.caddy" <<CADDY
# Written by 'routeflow install' from $CONF.
$DOMAIN {
	# next start leaves signed-in API JSON uncompressed; this covers every route but the live stream,
	# which compression would hold back or break (issue #58).
	@compress not path /api/live
	encode @compress zstd gzip
	# Photos (up to 20 MB) are the largest legitimate request.
	request_body {
		max_size 25MB
	}
	# N. routeflow maintenance on: the same page for everyone while work is done by hand.
	@maintenance file {
		root $CONF_DIR
		try_files maintenance.on
	}
	header @maintenance Cache-Control "no-store"
	header @maintenance Content-Type "text/html; charset=utf-8"
	respond @maintenance \`$(maintenance_page)\` 503
	respond /api/domains/ask 404
	reverse_proxy 127.0.0.1:$APP_PORT
	$(caddy_tls_line)
	# H. While the app restarts (an upgrade), a short Persian page instead of an error. Never cached,
	# so Arvan does not keep serving it after the app is back.
	handle_errors {
		@down expression \`{err.status_code} in [502, 503, 504]\`
		handle @down {
			header Cache-Control "no-store"
			header Retry-After "20"
			@api path /api/*
			respond @api \`{"ok":false,"maintenance":true}\` 503
			header Content-Type "text/html; charset=utf-8"
			respond \`$(maintenance_page)\` 503
		}
	}
}
CADDY
  # Company addresses (docs/release-and-deploy.md): any address a platform owner registers in the app reaches the
  # app. Caddy asks the app before it makes a certificate for a name it has not seen, so only registered names get one.
  cat > "$CADDY_DIR/sites/routeflow-companies.caddy" <<CADDY
# Written by 'routeflow install': every registered company address, whatever its name.
https:// {
	# Arvan shows the certificate to the browser, so the origin only needs one of its own (Arvan set not to check it).
	tls internal {
		on_demand
	}
	# Only Caddy itself may ask the app which addresses are registered.
	respond /api/domains/ask 404
	@compress not path /api/live
	encode @compress zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:$APP_PORT
}
CADDY
  # The permission check is a global option, so it goes in the Caddyfile itself (a global block inside an
  # imported file is refused): into the existing global block, or a new one at the top.
  if ! grep -q on_demand_tls "$CADDY_DIR/Caddyfile" 2>/dev/null; then
    local ask="	on_demand_tls {
		ask http://127.0.0.1:$APP_PORT/api/domains/ask
	}"
    if grep -q '^{' "$CADDY_DIR/Caddyfile" 2>/dev/null; then
      awk -v ask="$ask" '!done && /^\{/ { print; print ask; done=1; next } { print }' "$CADDY_DIR/Caddyfile" > "$CADDY_DIR/Caddyfile.new" && mv "$CADDY_DIR/Caddyfile.new" "$CADDY_DIR/Caddyfile"
    else
      { printf '{\n%s\n}\n\n' "$ask"; cat "$CADDY_DIR/Caddyfile"; } > "$CADDY_DIR/Caddyfile.new" && mv "$CADDY_DIR/Caddyfile.new" "$CADDY_DIR/Caddyfile"
    fi
  fi
  # Older installs imported $CADDY_DIR/routeflow.caddy by name: move to the glob.
  rm -f "$CADDY_DIR/routeflow.caddy"
  sed -i '\|^import /etc/caddy/routeflow.caddy$|d' "$CADDY_DIR/Caddyfile" 2>/dev/null || true
  grep -qxF 'import sites/*.caddy' "$CADDY_DIR/Caddyfile" 2>/dev/null \
    || printf '\nimport sites/*.caddy\n' >> "$CADDY_DIR/Caddyfile"
  caddy validate --config "$CADDY_DIR/Caddyfile" >/dev/null
  systemctl reload caddy || systemctl restart caddy
}

# ---- G. Rebuild on a new server ---------------------------------------------------------------------
# From the off-server copy (routeflow secrets backup) and the backups on the Pi: same secrets, same
# settings, the newest database the Pi holds.
cmd_rebuild() {
  need_root rebuild
  local bundle=${1:-} tarball=${2:-}
  [ -f "$bundle" ] || die "usage: routeflow rebuild <routeflow-secrets-....tar.asc> [tarball]"
  cmd_secrets restore "$bundle"
  load_conf
  [ -n "${OFFSITE_HOST:-}" ] || die "no OFFSITE_HOST in the restored settings: the backups that survive are on the Pi, and this copy does not name it"
  ROUTEFLOW_YES=1 RF_REBUILD=1 cmd_install ${tarball:+"$tarball"}
  say "Loading the newest database from $OFFSITE_HOST"
  ROUTEFLOW_YES=1 cmd_restore 2
  run_migrations "$ROOT/current"
  systemctl restart "$SERVICE"
  wait_healthy || die "the restored database is in place but the app is not healthy: routeflow logs"
  runuser -u postgres -- pgbackrest --stanza=routeflow check || warn "pgbackrest check failed; see routeflow doctor"
  say "Rebuilt: https://$DOMAIN serves the restored data. Sign in with your usual login."
}

# ---- L. Temporary access for a helper ---------------------------------------------------------------
# The key goes into root's authorized_keys with OpenSSH's own expiry-time, so sshd refuses it after
# the date even if nothing else runs; an hourly timer then removes the line.
SUPPORT_KEYS=${SUPPORT_KEYS:-/root/.ssh/authorized_keys}

support_expiry() {   # 3d, 12h -> YYYYMMDDHHMM (UTC) that many days or hours from now
  local n=${1%[dh]} unit=${1: -1}
  [[ $n =~ ^[0-9]+$ ]] && [ "$n" -gt 0 ] || return 1
  case "$unit" in d) date -u -d "+$n days" +%Y%m%d%H%M ;; h) date -u -d "+$n hours" +%Y%m%d%H%M ;; *) return 1 ;; esac
}

support_prune() {   # drop expired routeflow-support lines; prints how many
  local now line kept=0 dropped=0 tmp
  [ -f "$SUPPORT_KEYS" ] || { echo 0; return 0; }
  now=$(date -u +%Y%m%d%H%M); tmp=$(mktemp)
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ expiry-time=\"([0-9]{12})Z\".*routeflow-support ]] && [ "${BASH_REMATCH[1]}" -le "$now" ]; then
      dropped=$((dropped + 1)); continue
    fi
    printf '%s\n' "$line" >>"$tmp"; kept=$((kept + 1))
  done <"$SUPPORT_KEYS"
  cat "$tmp" >"$SUPPORT_KEYS"; rm -f "$tmp"
  echo "$dropped"
}

cmd_support_key() {
  need_root support-key
  local action=${1:-list} until
  case "$action" in
    add)
      [ -n "${2:-}" ] && [ -n "${3:-}" ] || die "usage: routeflow support-key add \"ssh-ed25519 AAAA... name\" 3d   (or 12h)"
      [[ $2 =~ ^(ssh-|ecdsa-|sk-)[^\ ]+\ [A-Za-z0-9+/=]+ ]] || die "that does not look like an SSH public key"
      until=$(support_expiry "$3") || die "how long: a number of days (3d) or hours (12h)"
      install -d -m 700 "$(dirname "$SUPPORT_KEYS")"
      printf 'expiry-time="%sZ" %s routeflow-support\n' "$until" "$2" >>"$SUPPORT_KEYS"
      chmod 600 "$SUPPORT_KEYS"
      say "Added until $(date -d "${until:0:8} ${until:8:2}:${until:10:2} UTC" '+%Y-%m-%d %H:%M %Z'). Remove sooner: routeflow support-key remove" ;;
    list) grep -n 'routeflow-support' "$SUPPORT_KEYS" 2>/dev/null | sed -E 's/^([0-9]+):expiry-time="([0-9]{8})([0-9]{4})Z" (\S+) \S+ (.*)/\1  until \2 \3 UTC  \4 \5/' || echo "no helper keys" ;;
    remove) sed -i '/routeflow-support$/d' "$SUPPORT_KEYS"; say "All helper keys removed" ;;
    prune) say "$(support_prune) expired helper key(s) removed" ;;
    *) die "routeflow support-key add <key> <3d|12h> | list | remove" ;;
  esac
}

write_support_timer() {
  cat >/etc/systemd/system/routeflow-support-prune.service <<'UNIT'
