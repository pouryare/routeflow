# ---- Install helpers: checks first, then the server's own safety -----------------------------------

# Problems that would make the install fail halfway, one per line; empty when none. Soft warnings go
# to stderr and do not stop anything.
preflight() {
  local mem_mb free_gb ip resolved
  . /etc/os-release 2>/dev/null || true
  case "${ID:-}" in ubuntu | debian) ;; *) echo "this installer is for Ubuntu or Debian, not ${ID:-unknown}" ;; esac
  mem_mb=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo)
  [ "$mem_mb" -ge 1500 ] || echo "only ${mem_mb} MB of memory; RouteFlow and PostgreSQL need at least 1.5 GB"
  free_gb=$(df -Pk / | awk 'NR==2 {print int($4/1048576)}')
  [ "$free_gb" -ge 10 ] || echo "only ${free_gb} GB free on /; keep at least 10 GB for releases, the database and backups"
  if ss -Hltnp '( sport = :80 or sport = :443 )' 2>/dev/null | grep -qv caddy; then
    echo "something other than Caddy already listens on port 80 or 443: $(ss -Hltnp '( sport = :80 or sport = :443 )' | grep -v caddy | awk '{print $NF}' | head -1)"
  fi
  resolved=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR==1 {print $1}' || true)
  if [ -z "$resolved" ]; then
    echo "$DOMAIN does not resolve yet; add its DNS record in the Arvan panel first"
  else
    ip=$(hostname -I 2>/dev/null)
    # Behind Arvan CDN the name resolves to Arvan, not here: that is fine when Arvan's origin is this server.
    [[ " $ip " == *" $resolved "* ]] || warn "$DOMAIN points to $resolved, this server is ${ip% }; if that is Arvan CDN, set its origin to this server"
  fi
}

# 2 GB of swap when there is none: a busy minute gets slow instead of killing PostgreSQL or the app.
ensure_swap() {
  [ -n "$(swapon --noheadings 2>/dev/null)" ] && return 0
  say "Swap: 2 GB"
  { fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap -q /swapfile && swapon /swapfile; } \
    || { rm -f /swapfile; warn "could not add swap (this disk may not allow a swap file); going on without"; return 0; }
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >>/etc/fstab
  echo 'vm.swappiness=10' >/etc/sysctl.d/60-routeflow-swap.conf
  sysctl -q -p /etc/sysctl.d/60-routeflow-swap.conf
}

# Kernel settings for a small web server behind a CDN, in a file of its own so the distribution's
# defaults stay untouched. Reasoned in docs/release-and-deploy.md ("Kernel settings").
write_sysctl() {
  cat <<'SYSCTL'
# Written by 'routeflow install'. See docs/release-and-deploy.md, "Kernel settings".

# BBR and fair queueing: steadier speed on lossy, long links (phones in Iran, Arvan, the Pi).
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
# Find a working packet size on paths that drop large packets (tunnels, some mobile networks).
net.ipv4.tcp_mtu_probing = 1
# Keep full speed on kept-alive connections from the CDN after a quiet moment.
net.ipv4.tcp_slow_start_after_idle = 0

# Queues for bursts of new connections. Node's own backlog is 511; Caddy's is the system's.
net.core.somaxconn = 4096
net.ipv4.tcp_max_syn_backlog = 8192
net.core.netdev_max_backlog = 16384

# Socket buffers up to 16 MB, so one big download (a backup to the Pi, photos) fills the link.
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216

# Closing and idle connections: free them sooner, notice dead peers in about 11 minutes, not 2 hours.
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 3
# Reuse closing outgoing connections (to PostgreSQL, the Pi). Needs timestamps, so those stay on.
net.ipv4.tcp_tw_reuse = 1
# Outgoing ports start above every port a service here listens on (3003, 5432, ...).
net.ipv4.ip_local_port_range = 10240 65535

# Safety: SYN flood cookies, no redirects, drop spoofed source addresses, reboot 10 s after a panic.
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.all.rp_filter = 1
kernel.panic = 10
SYSCTL
}

tune_kernel() {
  say "Kernel network settings (BBR, queues, buffers)"
  modprobe tcp_bbr 2>/dev/null || true
  echo tcp_bbr >/etc/modules-load.d/routeflow-bbr.conf
  write_sysctl >/etc/sysctl.d/60-routeflow.conf
  # One bad line must not stop the install: apply what the kernel accepts, warn about the rest.
  sysctl -q -p /etc/sysctl.d/60-routeflow.conf 2>&1 | sed 's/^/  sysctl: /' >&2 || warn "some kernel settings were refused (above)"
}

# The commands to paste on the Pi (as root): the backup user and folder with this server's key, and
# the monitor pointed at this server.
pi_pair_command() {
  local key=$1 user=$2 path=$3 domain=$4
  cat <<PAIR
sudo bash -c '
id $user >/dev/null 2>&1 || useradd -m -s /bin/bash $user
install -d -o $user -m 750 $path
install -d -o $user -m 700 ~$user/.ssh
grep -qxF "$key" ~$user/.ssh/authorized_keys 2>/dev/null || echo "$key" >> ~$user/.ssh/authorized_keys
chown $user ~$user/.ssh/authorized_keys; chmod 600 ~$user/.ssh/authorized_keys
printf "$user soft nofile 65536\\n$user hard nofile 65536\\n" > /etc/security/limits.d/routeflow-backup.conf
'
PAIR
  echo "# then the monitor (copy routeflow-monitor from this server's $ROOT/current/bin/ first):"
  echo "sudo bash routeflow-monitor install && sudo sed -i 's|^URL=.*|URL=https://$domain|' /etc/routeflow-monitor.conf"
}

# Makes the backup key now and checks the Pi takes it. Prints the pairing commands and returns 1
# when it does not, so the install goes on with local backups only.
pair_offsite() {
  local dir key
  dir=$(getent passwd postgres | cut -d: -f6)/.ssh
  install -d -o postgres -g postgres -m 700 "$dir"
  if [ ! -f "$dir/routeflow_backup" ] && [ -f /root/.routeflow-restore/routeflow_backup ]; then
    install -o postgres -g postgres -m 600 /root/.routeflow-restore/routeflow_backup "$dir/routeflow_backup"
    install -o postgres -g postgres -m 644 /root/.routeflow-restore/routeflow_backup.pub "$dir/routeflow_backup.pub"
  fi
  [ -f "$dir/routeflow_backup" ] || runuser -u postgres -- ssh-keygen -q -t ed25519 -N '' -C "routeflow-backup@$(hostname)" -f "$dir/routeflow_backup"
  runuser -u postgres -- sh -c "ssh-keyscan -H '$OFFSITE_HOST' >> '$dir/known_hosts' 2>/dev/null; sort -u -o '$dir/known_hosts' '$dir/known_hosts'"
  if runuser -u postgres -- ssh -i "$dir/routeflow_backup" -o BatchMode=yes -o ConnectTimeout=10 "$OFFSITE_USER@$OFFSITE_HOST" "test -d '$OFFSITE_PATH'" 2>/dev/null; then
    return 0
  fi
  key=$(cat "$dir/routeflow_backup.pub")
  PI_PAIRING=$(pi_pair_command "$key" "$OFFSITE_USER" "$OFFSITE_PATH" "$DOMAIN")
  return 1
}

# The tarball to install: the one named, else the newest for this machine in incoming/, else in the
# current folder.
install_tarball() {
  local t=${1:-}
  if [ -z "$t" ]; then
    t=$(newest_incoming)
    [ -n "$t" ] || t=$(ls -1 routeflow-*-linux-"$(machine_arch)".tar.gz 2>/dev/null | sort -V | tail -1)
  fi
  [ -n "$t" ] && [ -f "$t" ] || return 1
  echo "$t"
}

# A random password: letters and digits only, so it survives copying from any terminal.
new_password() { head -c 64 /dev/urandom | base64 | tr -dc 'A-HJ-NP-Za-km-z2-9' | head -c "${1:-16}"; }

# SQL as the database owner over the socket, like the migrations.
owner_psql() { as_app psql -X -q -At -v ON_ERROR_STOP=1 -d "postgres:///$DB_NAME?host=/var/run/postgresql" "$@"; }

# First install only: the company's name, and the first login, a platform owner (all of owner's
# rights, plus the other companies). Its password is printed once; nothing on disk keeps it.
ensure_owner() {
  local pw rel=$ROOT/current
  if [ -n "$COMPANY_NAME" ]; then
    owner_psql -v name="$COMPANY_NAME" <<'SQL'
UPDATE organizations SET name = :'name' WHERE id = 1;
SQL
  fi
  [ "$(owner_psql -c "SELECT COUNT(*) FROM users WHERE role = 'platform_owner'")" = 0 ] || { rm -f "$CONF_DIR/.owner-password"; return 0; }
  pw=${OWNER_PASSWORD:-$(new_password)}
  printf '%s\n' "$pw" | as_app env DATABASE_URL="postgres:///$DB_NAME?host=/var/run/postgresql" \
    "$rel/node/bin/node" "$rel/scripts/create-user.mjs" "$OWNER_USER" - "${OWNER_NAME:-مدیر سامانه}" platform_owner >/dev/null
  OWNER_CREATED_PASSWORD=$pw
  rm -f "$CONF_DIR/.owner-password"
}


# Config files copied before a re-run changes them, so a bad run can be put back by hand.
snapshot_config() {
  [ -f "$CONF" ] || return 0
  local out=/var/backups/routeflow-config-$(date +%Y%m%d-%H%M%S).tar.gz
  install -d -m 700 /var/backups
  tar -czf "$out" -C / --ignore-failed-read "${CONF_DIR#/}" "${CADDY_DIR#/}/Caddyfile" "${CADDY_DIR#/}/sites" etc/sysctl.d/60-routeflow.conf etc/ufw 2>/dev/null || true
  chmod 600 "$out"
  ls -1t /var/backups/routeflow-config-*.tar.gz 2>/dev/null | tail -n +6 | xargs -r rm -f
  say "Settings copied to $out (put back with: sudo tar -xzf $out -C /)"
}

# An install keeps going in a systemd unit, so a dropped SSH connection cannot stop it halfway. This
# process only watches the log. The first login's password goes to a root-only file, shown by 'first-login'.
detach_install() {
  local tarball self log=/var/log/routeflow-install.log tailpid
  self=$(readlink -f "$0"); tarball=$(readlink -f "$1")
  if [ -n "${OWNER_PASSWORD:-}" ]; then ( umask 077; printf '%s' "$OWNER_PASSWORD" > "$CONF_DIR/.owner-password" ); fi
  if [ -n "${ARVAN_API_KEY:-}" ]; then ( umask 077; printf '%s' "$ARVAN_API_KEY" > "$CONF_DIR/.arvan-key" ); fi
  rm -f "$CONF_DIR/first-login" "$CONF_DIR/last-install-ok"
  touch "$log"
  say "Running in the background. Closing this window or losing the connection does not stop it."
  say "Watch again with: sudo tail -f $log      When it says Done: sudo routeflow first-login"
  set_title "RouteFlow: installing..."
  tail -n 0 -F "$log" 2>/dev/null & tailpid=$!
  systemd-run --unit=routeflow-install --collect --wait --quiet \
    --setenv=ROUTEFLOW_YES=1 --setenv=ROUTEFLOW_DETACHED=1 \
    -p StandardOutput=null -p StandardError=null \
    bash "$self" install "$tarball" || true
  sleep 1; kill "$tailpid" 2>/dev/null || true
  if [ -f "$CONF_DIR/last-install-ok" ]; then
    set_title "RouteFlow: install done"
    cmd_first_login || true
  else
    set_title "RouteFlow: install FAILED"
    warn "the install did not finish; the last lines above say why. Run it again to continue, or: sudo routeflow support-file"
    return 1
  fi
}

# The first login, once. Also the way back when the window was closed before it was read.
cmd_first_login() {
  local f=$CONF_DIR/first-login
  need_root first-login
  [ -s "$f" ] || die "no first login is waiting (it was already shown). To set a new password: sudo routeflow reset-login <username>"
  cat "$f"; rm -f "$f"
}

# Where the link to the backup machine (the Pi) stands: ok, network, nokey, key (not accepted), hostkey, folder.
pi_state() {
  local dir out
  dir=$(getent passwd postgres | cut -d: -f6)/.ssh
  reachable "$OFFSITE_HOST" || { echo network; return; }
  [ -f "$dir/routeflow_backup" ] || { echo nokey; return; }
  out=$(runuser -u postgres -- ssh -i "$dir/routeflow_backup" -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "$OFFSITE_USER@$OFFSITE_HOST" "test -d '$OFFSITE_PATH' && touch '$OFFSITE_PATH/.rf-test' && rm -f '$OFFSITE_PATH/.rf-test' && echo RF_OK" 2>&1 || true)
  case "$out" in
    *RF_OK*) echo ok ;;
    *"Permission denied"*) echo key ;;
    *"Host key"*) echo hostkey ;;
    *"timed out"* | *"Connection"* | *"No route"*) echo network ;;
    *) echo folder ;;
  esac
}

pi_state_text() {
  case "$1" in
    ok) echo "The Pi takes the backup key and the folder is writable." ;;
    network) echo "The Pi does not answer on port 22 from here. Check its address, that it is on, and the router/firewall." ;;
    nokey) echo "This server has no backup key yet. Run: sudo routeflow install" ;;
    key) echo "The Pi did not accept the backup key. Paste the commands below on the Pi, then run check-pi again." ;;
    hostkey) echo "The Pi's host key changed. If you reinstalled the Pi: sudo -u postgres ssh-keygen -R <its address>, then run check-pi again." ;;
    folder) echo "The key works but the backup folder is missing or not writable. The commands below create it." ;;
  esac
}

# 25: tries the Pi link and says which part is wrong.
cmd_check_pi() {
  need_root check-pi
  load_conf
  [ -n "${OFFSITE_HOST:-}" ] || die "no backup machine is set (OFFSITE_HOST in $CONF)"
  local st dir
  st=$(pi_state)
  pi_state_text "$st"
  if [ "$st" = key ] || [ "$st" = folder ]; then
    dir=$(getent passwd postgres | cut -d: -f6)/.ssh
    printf '\n%s\n' "$(pi_pair_command "$(cat "$dir/routeflow_backup.pub")" "$OFFSITE_USER" "$OFFSITE_PATH" "$DOMAIN")"
  fi
  [ "$st" = ok ]
}

# 24: only the final green/red check again, for after a fix in the Arvan panel or on the Pi.
cmd_install_report() {
  need_root install-report
  load_conf
  [ ! -f /var/lib/routeflow/backups/backup-status.json ] || BACKUP_OK=1
  install_report
}

# Idea 10/6: a plain green/red list at the end, with what to do about each red line.
install_report() {
  local resolved code mine
  ok() { printf '  ✓ %s\n' "$*"; }
  bad() { printf '  ✗ %s\n' "$*"; }
  printf '\nFinal check\n'
  if curl -fsS --max-time 5 "http://127.0.0.1:$(app_port)/api/health" >/dev/null 2>&1; then ok "The app answers on this server"; else bad "The app does not answer: sudo journalctl -u $SERVICE -n 50"; fi
  resolved=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR==1{print $1}' || true)
  mine=$(hostname -I 2>/dev/null || true)
  if [ -z "$resolved" ]; then
    bad "$DOMAIN does not resolve yet. In the Arvan panel add an A record pointing at this server's IP."
  elif grep -qw "$resolved" <<<"$mine"; then
    if [ "${CDN_ONLY:-1}" = 1 ]; then bad "$DOMAIN points straight at this server, but the firewall lets only Arvan in. In the Arvan panel switch the record's cloud to ON."; else ok "$DOMAIN points straight at this server (Arvan's cloud is off)"; fi
  else
    ok "$DOMAIN points at $resolved (Arvan's side)"
  fi
  code=$(curl -ksS -o /dev/null -w '%{http_code}' --max-time 10 "https://$DOMAIN/api/health" 2>/dev/null || true)
  if [ "$code" = 200 ]; then ok "https://$DOMAIN answers"; else bad "https://$DOMAIN did not answer (code ${code:-none}). Check in the Arvan panel: cloud ON, and SSL set to match the certificate you chose."; fi
  if [ "${BACKUP_OK:-0}" = 1 ]; then ok "A backup was made and restored"; else bad "The backup self-test failed: journalctl -u 'routeflow-backup@*'"; fi
  if [ -z "${OFFSITE_HOST:-}" ]; then
    printf '  - Backups stay on this server only (no Pi chosen)\n'
  else
    local pst; pst=$(pi_state)
    if [ "$pst" = ok ]; then ok "Backups also go to $OFFSITE_HOST"; else bad "Pi $OFFSITE_HOST: $(pi_state_text "$pst") (test again: sudo routeflow check-pi)"; fi
  fi
}

# Idea 11: what to do next, in order.
install_next_steps() {
  printf '\nNext, in this order:\n  1. Open https://%s and sign in with the first login above; change the password.\n  2. Turn on Google Authenticator for it (Account menu).\n  3. sudo routeflow secrets backup   (and keep the file in the private repo, never the public one)\n  4. sudo routeflow secrets set TELEGRAM_BOT_TOKEN   (and the SMS key) so alerts reach you\n' "$DOMAIN"
  # Idea 18: scan it with a phone instead of typing the address.
  if command -v qrencode >/dev/null 2>&1; then printf '\nOpen it on your phone:\n'; qrencode -t ANSIUTF8 "https://$DOMAIN" || true; fi
}

# Needs an Arvan API key in ARVAN_API_KEY. Makes the A record for $DOMAIN point at this server with the cloud on
# (changes the record when it exists) and turns Arvan's managed HTTPS on, best effort. Prints Arvan's own message on failure.
# shortcut: paths and fields come from API client libraries, not Arvan's reference; the first real run may need a fix here
# and in lib/arvan.ts. ARVAN_API_BASE exists for the test.
arvan_point_domain() {
  local out
  out=$(ARVAN_API_KEY=$ARVAN_API_KEY python3 - "$DOMAIN" "$1" 2>&1 <<'PY'
import json, os, sys, urllib.request, urllib.error
host, ip = sys.argv[1].lower(), sys.argv[2]
labels = host.split(".")
keep = 3 if len(labels) > 2 and labels[-2] in ("co", "ac", "gov", "org", "net", "sch", "id") and len(labels[-1]) == 2 else 2
root, name = ".".join(labels[-keep:]), ".".join(labels[:-keep]) or "@"
base = os.environ.get("ARVAN_API_BASE", "https://napi.arvancloud.ir/cdn/4.0")
key = os.environ["ARVAN_API_KEY"]
def call(method, path, body=None, ok404=False):
    req = urllib.request.Request(base + path, method=method, data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": key if key.lower().startswith("apikey ") else "Apikey " + key, "Content-Type": "application/json", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read() or b"{}").get("data")
    except urllib.error.HTTPError as e:
        if e.code == 404 and ok404: return None
        try: msg = json.loads(e.read()).get("message")
        except Exception: msg = None
        sys.exit("Arvan: %s" % (msg or e.code))
    except Exception as e:
        sys.exit("Arvan: %s" % e)
if call("GET", "/domains/" + root, ok404=True) is None:
    sys.exit("Arvan: %s is not in your Arvan account yet; add the domain there first" % root)
rec = {"type": "a", "name": name, "value": [{"ip": ip, "port": None, "weight": None, "country": ""}], "ttl": 120, "cloud": True,
       "upstream_https": "default", "ip_filter_mode": {"count": "single", "order": "none", "geo_filter": "none"}}
found = [r for r in (call("GET", "/domains/%s/dns-records?search=%s" % (root, name)) or []) if str(r.get("type", "")).lower() == "a" and r.get("name") == name]
if found: call("PUT", "/domains/%s/dns-records/%s" % (root, found[0]["id"]), rec)
else: call("POST", "/domains/%s/dns-records" % root, rec)
try: call("PATCH", "/domains/%s/ssl" % root, {"ssl_status": True, "certificate": "managed"})
except SystemExit: pass
PY
  ) || { warn "$out"; return 1; }
  say "Arvan: $DOMAIN now points at $1 with the cloud on"
}

# The server's public IPv4: the first address that is not private, loopback or carrier-grade NAT.
public_ip() {
  hostname -I 2>/dev/null | tr ' ' '\n' | awk -F. 'NF==4 && !($1==10 || $1==127 || ($1==172 && $2>=16 && $2<=31) || ($1==192 && $2==168) || ($1==169 && $2==254) || ($1==100 && $2>=64 && $2<=127)) {print; exit}'
}

# Keeps the key for the app: moved from the install's root-only file (or the environment) into the encrypted secrets.
ensure_arvan_key() {
  local f="$CONF_DIR/.arvan-key" t
  [ -n "${ARVAN_API_KEY:-}" ] || { [ -f "$f" ] && ARVAN_API_KEY=$(cat "$f"); }
  rm -f "$f"
  [ -n "${ARVAN_API_KEY:-}" ] || return 0
  t=$(secret_tmp)
  secrets_read >"$t/old"
  printf 'ARVAN_API_KEY=%s\n' "$ARVAN_API_KEY" >"$t/new"
  merge_env "$t/old" "$t/new" >"$t/all"
  secrets_write "$t/all"
  rm -rf "$t"
  say "Arvan key saved with the other secrets"
}

# Idea 17: stop for the steps only a person can do, in the Arvan panel, instead of failing at the end.
pause_for_arvan() {
  local resolved me go a_done=0
  me=$(public_ip); me=${me:-$(hostname -I 2>/dev/null | awk '{print $1}')}
  if [ -n "${ARVAN_API_KEY:-}" ] && [ -n "$me" ] && arvan_point_domain "$me"; then a_done=1; fi
  interactive || return 0
  resolved=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR==1{print $1}' || true)
  if [ "$a_done" = 1 ]; then printf '\nBefore I start, one thing only you can do in the Arvan panel (the A record is already made):\n' >/dev/tty
  else printf '\nBefore I start, two things only you can do in the Arvan panel:\n  a. Add an A record  %s  ->  this server'"'"'s IP (%s), with the cloud switch ON.\n' "$DOMAIN" "${me:-unknown}" >/dev/tty; fi
  if [ "${CERT_MODE:-internal}" = internal ]; then printf '  b. Set SSL to "do not verify the origin" (you chose Caddy'"'"'s own certificate).\n' >/dev/tty; else printf '  b. Put the origin certificate in %s/tls/ (origin.crt, origin.key) if you use one.\n' "$CONF_DIR" >/dev/tty; fi
  if [ -n "$resolved" ]; then printf '  (%s already resolves to %s.)\n' "$DOMAIN" "$resolved" >/dev/tty; fi
  go=1; ask_yes go "Done, or do it after the install?  Yes = go on now." 1
  [ "$go" = 1 ] || die "stopped, nothing was changed"
}

# Idea 9: what a real run would do, without doing it.
install_check_report() {
  printf '\nDry run: nothing was changed. A real run would:\n'
  printf '  - add packages (Caddy, PostgreSQL client, ufw, updates) from %s\n' "$([ "${APT_MIRROR:-https://mirror.arvancloud.ir}" = off ] && echo "the system sources" || echo "the Arvan mirror, falling back to the system sources")"
  printf '  - open the firewall for SSH and ports 80/443 (%s)\n' "$([ "${CDN_ONLY:-1}" = 1 ] && echo "Arvan only" || echo "everyone")"
  printf '  - set the Tehran time zone, clock servers, 2 GB swap and network settings\n'
  printf '  - install PostgreSQL, backups%s\n' "${OFFSITE_HOST:+ (also to $OFFSITE_HOST)}"
  printf '  - install the app as the service "%s" and Caddy for %s\n' "$SERVICE" "$DOMAIN"
  printf '  - create the first login "%s" and run a backup and restore test\n' "${OWNER_USER:-admin}"
}

cmd_install() {
  local tarball version tmp check=0
  while [ $# -gt 0 ]; do
    case "$1" in --yes) ROUTEFLOW_YES=1; shift ;; --check) check=1; shift ;; *) break ;; esac
  done
  tarball=$(install_tarball "${1:-}") || {
    interactive || die "usage: routeflow install [--yes] [--check] <routeflow-X.Y.Z-linux-ARCH.tar.gz> (none found in $ROOT/incoming or here)"
    ask TARBALL_PATH "0. I did not find the release file (routeflow-X.Y.Z-linux-$(machine_arch).tar.gz) here. Where is it?" ""
    tarball=$(install_tarball "$TARBALL_PATH") || die "no such file: $TARBALL_PATH"
  }
  need_root install
  load_conf
  APP_PORT=${APP_PORT:-3003}; KEEP_RELEASES=${KEEP_RELEASES:-3}; UPGRADE_AT=${UPGRADE_AT:-*-*-* 03:30:00 Asia/Tehran}
  install_questions
  # With --yes the same values come from the environment or $CONF.
  OFFSITE_USER=${OFFSITE_USER:-rfbackup}; OFFSITE_PATH=${OFFSITE_PATH:-/srv/routeflow-pgbackrest}
  OWNER_USER=${OWNER_USER:-admin}
  [ -n "$DOMAIN" ] || die "a domain is needed"
  valid_domain "$DOMAIN" || die "'$DOMAIN' is not a domain name (example: app.example.ir)"
  valid_pubkey "${DEPLOY_PUBKEY:-}" || die "DEPLOY_PUBKEY is not an SSH public key line"
  local problems
  if [ "${ROUTEFLOW_DETACHED:-0}" != 1 ]; then
    say "Checking this machine"
    problems=$(preflight)
    [ -z "$problems" ] || die "not installing, fix these first:
$problems"
    if [ "$check" = 1 ]; then install_check_report; return 0; fi
    snapshot_config
    # Idea 19: a re-run on a working server starts with a backup, so a bad run cannot cost data.
    if [ -n "$(current_version)" ]; then say "Backup before changing anything"; cmd_backup incr || warn "the backup before the re-run failed; go on only if you accept that"; fi
    pause_for_arvan
    write_conf
    if interactive && command -v systemd-run >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
      detach_install "$tarball"; return
    fi
  fi
  # Everything below also goes to the log, to send along when something fails. The first login's
  # password goes only to the screen (fd 3) or, in the background, to a root-only file; never to the log.
  if [ "${ROUTEFLOW_DETACHED:-0}" = 1 ]; then
    ( umask 077; : > "$CONF_DIR/first-login" ); exec 3>>"$CONF_DIR/first-login"
    if [ -f "$CONF_DIR/.owner-password" ]; then OWNER_PASSWORD=$(cat "$CONF_DIR/.owner-password"); fi
  else
    exec 3>&1
  fi
  exec > >(tee -a /var/log/routeflow-install.log) 2>&1
  trap 'rc=$?; [ "$rc" = 0 ] || printf "\n!! The install stopped at step %s of %s (exit %s).\n   Run it again to continue (the package step is not repeated). For help: sudo routeflow support-file\n   Settings before this run are in /var/backups/routeflow-config-*.tar.gz\n" "$STEP_N" "$STEP_TOTAL" "$rc"' EXIT
  say "routeflow install $(date '+%F %T'), log: /var/log/routeflow-install.log"
  STEP_N=1; STEP_PREV="Checks (done before the install started)"; STEP_T=$(date +%s)
  printf '== [%s] 1/%s %s\n' "$(progress_bar 1 "$STEP_TOTAL")" "$STEP_TOTAL" "$STEP_PREV"
  INSTALL_T0=$(date +%s)

  step "Packages"
  if step_done packages; then
    say "Already installed by an earlier run; skipping (ROUTEFLOW_FRESH=1 repeats it)"
  else
    use_iran_mirror
    apt-get update -q
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \
      ca-certificates curl tar gnupg openssl whiptail ufw unattended-upgrades caddy postgresql-client
    # Only for the QR code at the end: a failure here must not stop the install.
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends qrencode || true
    mark_step packages
  fi

  step "Firewall: SSH, and the web ports for Arvan's CDN only"
  ufw allow OpenSSH >/dev/null
  # Open to all first, so a failed address-list download never leaves the site unreachable.
  ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null
  ufw --force enable >/dev/null
  cmd_cdn_ips

  step "Clock, security updates, swap and network settings"
  # Tehran time on the server, so logs and the reboot window read the way the owner thinks.
  timedatectl set-timezone Asia/Tehran
  set_time_servers
  # Night order (Tehran): 01:30 backup, 02:30 OS reboot if an update needs one, 03:30 app upgrade,
  # 04:00 on the 1st the restore drill.
  cat > /etc/apt/apt.conf.d/52routeflow-upgrades <<APT
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "02:30";
APT
  systemctl enable --now unattended-upgrades >/dev/null 2>&1 || true

  ensure_swap
  tune_kernel

  say "Log size cap"
  install -d /etc/systemd/journald.conf.d
  printf '[Journal]\nSystemMaxUse=500M\n' > /etc/systemd/journald.conf.d/routeflow.conf
  systemctl restart systemd-journald

  # The database installer ships inside the release, so it always matches the migrations.
  tmp=$(mktemp -d)
  tar -xzf "$tarball" -C "$tmp" --strip-components=1 --wildcards '*/db/server/*'
  step "Database, roles, backups"
  # A rebuilt server with restored secrets keeps the web role's password from DATABASE_URL.
  local offsite=$OFFSITE_HOST
  if [ -n "$OFFSITE_HOST" ] && ! pair_offsite; then
    warn "$OFFSITE_HOST does not take the backup key yet: backups stay on this server for now (commands for the Pi at the end)"
    offsite=""
  fi
  WEB_PASS=$(secret_value DATABASE_URL | sed -n 's|^postgres://[^:]*:\([^@]*\)@.*|\1|p') \
    RF_REBUILD=${RF_REBUILD:-0} APP_DIR=$ROOT OFFSITE_HOST=$offsite OFFSITE_USER=${OFFSITE_USER:-} OFFSITE_PATH=${OFFSITE_PATH:-} \
    bash "$tmp/db/server/install.sh" --no-migrate
  rm -rf "$tmp"
  secrets_absorb
  install -d -o "$APP_USER" -g "$APP_USER" "$ROOT" "$ROOT/data" "$ROOT/data/photos" "$ROOT/data/map" "$ROOT/data/cache" "$ROOT/data/held"

  step "App service, timers and the deploy user"
  write_app_unit
  # The backup units run the scripts of the live release, with the secrets like the app.
  sed -i "s|^WorkingDirectory=.*|WorkingDirectory=$ROOT/current|; s|^ExecStart=/usr/bin/node |ExecStart=$ROOT/current/node/bin/node --env-file=%d/secrets |; /^LoadCredentialEncrypted=/d; /^EnvironmentFile=/a LoadCredentialEncrypted=secrets:$SECRETS" \
    /etc/systemd/system/routeflow-backup@.service /etc/systemd/system/routeflow-restore-drill.service 2>/dev/null || true
  write_upgrade_timer
  write_cdn_timer
  write_support_timer
  write_motd
  ensure_sweep_token
  ensure_arvan_key
  write_storage_timers
  write_archive_timer
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null
  systemctl enable --now routeflow-upgrade.timer routeflow-cdn-ips.timer routeflow-support-prune.timer >/dev/null
  systemctl enable --now routeflow-storage-jobs.timer routeflow-storage-daily.timer routeflow-storage-weekly.timer >/dev/null
  systemctl enable --now routeflow-archive.timer >/dev/null
  install -d -o "$APP_USER" -g "$APP_USER" -m 775 "$ROOT/incoming"
  # The key-only user GitHub copies releases as (docs/release-and-deploy.md) may write here, nothing more.
  if [ -n "${DEPLOY_PUBKEY:-}" ] && ! id deploy >/dev/null 2>&1; then
    say "Deploy user (key only, can only drop files in $ROOT/incoming)"
    useradd -m -s /bin/bash deploy
    passwd -l deploy >/dev/null
  fi
  if id deploy >/dev/null 2>&1; then
    usermod -aG "$APP_USER" deploy
    if [ -n "${DEPLOY_PUBKEY:-}" ]; then
      install -d -m 700 -o deploy -g deploy ~deploy/.ssh
      grep -qxF "$DEPLOY_PUBKEY" ~deploy/.ssh/authorized_keys 2>/dev/null || printf '%s\n' "$DEPLOY_PUBKEY" >>~deploy/.ssh/authorized_keys
      chown deploy:deploy ~deploy/.ssh/authorized_keys; chmod 600 ~deploy/.ssh/authorized_keys
    fi
  fi

  step "Caddy for $DOMAIN"
  write_caddy

  step "The first release"
  if [ -z "$(current_version)" ]; then
    cmd_upgrade "$tarball"
  else
    say "A release is already live ($(current_version)); to change it: routeflow upgrade <tarball>"
  fi
  ln -sfn "$ROOT/current/bin/routeflow" /usr/local/bin/routeflow
  if [ "${RF_REBUILD:-0}" = 1 ]; then trap - EXIT; return 0; fi   # routeflow rebuild loads the real database next
  step "First login and company name"
  ensure_owner

  step "Self-test: a full backup, then restoring it into a scratch copy"
  BACKUP_OK=0
  if systemctl start routeflow-backup@full && systemctl start routeflow-restore-drill; then
    BACKUP_OK=1
    say "Backups work: one was made and restored"
  else
    warn "the backup self-test failed; see: journalctl -u 'routeflow-backup@*' -u routeflow-restore-drill"
  fi
  step "Final check"
  install_report
  say "Done in $(( $(date +%s) - INSTALL_T0 )) s: https://$DOMAIN"
  if [ -n "${PI_PAIRING:-}" ]; then
    printf '\nOn the Pi, paste this, then run  sudo routeflow install --yes  here again:\n\n%s\n\n' "$PI_PAIRING"
  fi
  if [ -n "${OWNER_CREATED_PASSWORD:-}" ]; then
    printf '\n  First login (shown once; change it after signing in):\n    username: %s\n    password: %s\n\n' "$OWNER_USER" "$OWNER_CREATED_PASSWORD" >&3
  fi
  step_times
  install_next_steps
  set_title "RouteFlow: install done"
  [ "${ROUTEFLOW_DETACHED:-0}" != 1 ] || date -Is > "$CONF_DIR/last-install-ok"
  trap - EXIT
}

menu() {
  command -v whiptail >/dev/null || die "whiptail is not installed; run a command instead (routeflow help)"
  local choice arg
  choice=$(whiptail --title "RouteFlow $(current_version)" --menu "What do you want to do?" 19 76 10 \
    status "Check the app, database, disk and backups" \
    upgrade "Upgrade to a release tarball now" \
    upgrade-scheduled "Apply the waiting release now instead of tonight" \
    rollback "Go back to the previous release" \
    backup "Run a backup now" \
    restore-drill "Test that the newest backup restores" \
    logs "Show the latest app log" \
    restore "Replace the database with a backup" \
    secrets "List the secret names (set them with: routeflow secrets set KEY)" \
    install "Install or re-apply the server setup" \
    3>&1 1>&2 2>&3) || exit 0
  case "$choice" in
    upgrade | install)
      arg=$(whiptail --inputbox "Path to the release tarball:" 10 70 "$(ls -1t "$ROOT"/incoming/routeflow-*.tar.gz 2>/dev/null | head -1)" 3>&1 1>&2 2>&3) || exit 0
      main "$choice" "$arg" ;;
    restore)
      arg=$(whiptail --menu "Restore from which copy?" 12 70 2 1 "This machine" 2 "The second machine" 3>&1 1>&2 2>&3) || exit 0
      main restore "$arg" ;;
    *) main "$choice" ;;
  esac
}

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
  local cmd=${1:-}
  [ $# -gt 0 ] && shift
  case "$cmd" in
    install) cmd_install "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    upgrade-scheduled) cmd_upgrade_scheduled ;;
    rollback | switch) cmd_rollback "$@" ;;
    status) cmd_status ;;
    status-short) status_short ;;
    doctor) cmd_doctor ;;
    cdn-ips) cmd_cdn_ips "$@" ;;
    arvan-probe) cmd_arvan_probe "$@" ;;
    check-pi) cmd_check_pi ;;
    install-report) cmd_install_report ;;
    rebuild) cmd_rebuild "$@" ;;
    support-key) cmd_support_key "$@" ;;
    export) cmd_export "$@" ;;
    import) cmd_import "$@" ;;
    sql) cmd_sql "$@" ;;
    maintenance) cmd_maintenance "$@" ;;
    reset-login) cmd_reset_login "$@" ;;
    tidy) cmd_tidy ;;
    support-file) cmd_support_file "$@" ;;
    first-login) cmd_first_login ;;
    uninstall) cmd_uninstall ;;
    backup) cmd_backup "$@" ;;
    restore-drill) cmd_restore_drill ;;
    restore) cmd_restore "$@" ;;
    logs) cmd_logs "$@" ;;
    secrets) cmd_secrets "$@" ;;
    help | -h | --help) usage ;;
    "") if [ -t 0 ]; then menu; else usage; fi ;;
    *) usage; exit 2 ;;
  esac
}

# Sourced by the tests (tests/routeflow-cli.test.ts) to call the helpers; run otherwise.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
