Description=RouteFlow: remove expired helper SSH keys, hourly
[Timer]
OnCalendar=hourly
Persistent=true
[Install]
WantedBy=timers.target
UNIT
}

# ---- Database export, import and one-off SQL fixes --------------------------------------------------
# export: a pg_dump file to send for a look (all companies, personal data included: share it only
#         over a private channel). import: replaces the live database with such a file; the old one
#         is kept under another name. sql: runs a reviewed .sql fix in one transaction, after a backup.
EXPORT_DIR=/var/lib/routeflow/exports

cmd_export() {
  need_root export
  local anon=0 enc=0 out="" tmpdb
  while [ $# -gt 0 ]; do
    case "$1" in --anonymise | --anonymize) anon=1 ;; --encrypt) enc=1 ;; *) out=$1 ;; esac
    shift
  done
  out=${out:-$EXPORT_DIR/routeflow-$(date +%Y%m%d-%H%M)$([ "$anon" = 1 ] && echo -anon).dump}
  install -d -o "$APP_USER" -g "$APP_USER" -m 750 "$(dirname "$out")"
  if [ "$anon" = 1 ]; then
    # A scratch copy (made as a template of the live one), changed, dumped and dropped: the live
    # database is never touched.
    tmpdb="${DB_NAME}_anon_$(date +%s)"
    say "Copying the database to change people's details in the copy only"
    as_app pg_dump -Fc "postgres:///$DB_NAME?host=/var/run/postgresql" \
      | { runuser -u postgres -- createdb -O "$APP_USER" "$tmpdb" && runuser -u postgres -- pg_restore --exit-on-error -d "$tmpdb"; } \
      || { runuser -u postgres -- dropdb --if-exists "$tmpdb"; die "could not make the scratch copy"; }
    if ! anonymise_sql | runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d "$tmpdb"; then
      runuser -u postgres -- dropdb --if-exists "$tmpdb"; die "could not replace the details; nothing was written"
    fi
    runuser -u postgres -- pg_dump -Fc -Z 6 -d "$tmpdb" >"$out"
    runuser -u postgres -- dropdb "$tmpdb"
  else
    as_app pg_dump -Fc -Z 6 -f "$out" "postgres:///$DB_NAME?host=/var/run/postgresql"
  fi
  if [ "$enc" = 1 ]; then
    say "Choose a passphrase; send it separately from the file."
    gpg --pinentry-mode loopback --symmetric --cipher-algo AES256 -o "$out.gpg" "$out" && rm -f "$out"
    out=$out.gpg
  fi
  chmod 640 "$out"
  if [ "$anon" = 1 ]; then
    say "Wrote $out ($(du -h "$out" | cut -f1)): names, phones, addresses and notes replaced. Map points and amounts are real."
  else
    say "Wrote $out ($(du -h "$out" | cut -f1)). Send it privately; it holds every company's data."
  fi
}

confirm() {   # confirm WORD message
  if [ "${ROUTEFLOW_YES:-0}" = 1 ]; then return 0; fi
  [ -t 0 ] || die "not on a terminal: set ROUTEFLOW_YES=1 to confirm"
  read -r -p "$2 Type $1 to go on: " answer
  [ "$answer" = "$1" ] || die "nothing changed"
}

cmd_import() {
  need_root import
  local file=${1:-} stamp old
  [ -f "$file" ] || die "usage: routeflow import <file.dump>   (made by routeflow export or pg_dump -Fc)"
  if [[ $file == *.gpg ]]; then
    install -d -m 700 "$EXPORT_DIR/.import"
    gpg --pinentry-mode loopback -q -d -o "$EXPORT_DIR/.import/in.dump" "$file" || die "could not open $file"
    file=$EXPORT_DIR/.import/in.dump
    trap 'rm -rf "$EXPORT_DIR/.import"' EXIT
  fi
  pg_restore -l "$file" >/dev/null 2>&1 || die "$file is not a pg_dump custom-format file"
  confirm IMPORT "This stops the app and replaces the whole database with $(basename "$file")."
  stamp=$(date +%Y%m%d_%H%M%S); old="${DB_NAME}_before_import_$stamp"
  say "Backup first"
  systemctl start routeflow-backup@incr 2>/dev/null || warn "the backup before import failed; going on, the old database is kept anyway"
  systemctl stop "$SERVICE" || true
  runuser -u postgres -- psql -X -q -v ON_ERROR_STOP=1 -d postgres <<SQL
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$DB_NAME' AND pid <> pg_backend_pid();
ALTER DATABASE "$DB_NAME" RENAME TO "$old";
CREATE DATABASE "$DB_NAME" OWNER "$APP_USER";
SQL
  # As the superuser, so extensions (PostGIS) are created; ownership in the file stays the app's.
  # Read by root and handed over on stdin: the file can sit anywhere, unreadable to postgres.
  if ! runuser -u postgres -- pg_restore --exit-on-error -d "$DB_NAME" <"$file"; then
    warn "the import failed; putting the old database back"
    runuser -u postgres -- psql -X -q -d postgres -c "DROP DATABASE \"$DB_NAME\"" -c "ALTER DATABASE \"$old\" RENAME TO \"$DB_NAME\""
    systemctl start "$SERVICE"
    die "nothing changed"
  fi
  run_migrations "$ROOT/current"
  systemctl start "$SERVICE"
  wait_healthy || warn "the app is not healthy after the import: routeflow logs"
  say "Imported. The previous database is kept as $old; drop it once you are happy:"
  say "  sudo -u postgres dropdb $old"
}

cmd_sql() {
  need_root sql
  local file=${1:-}
  [ -f "$file" ] || die "usage: routeflow sql <fix.sql>   (runs it in one transaction, after a backup)"
  echo "---- $file"; cat "$file"; echo "----"
  confirm APPLY "This runs the SQL above on the live database."
  systemctl start routeflow-backup@incr 2>/dev/null || die "the backup before the change failed; nothing was run"
  as_app psql -X -v ON_ERROR_STOP=1 --single-transaction -d "postgres:///$DB_NAME?host=/var/run/postgresql" -f "$file" \
    || die "the SQL failed and was rolled back; nothing changed"
  say "Applied. To undo: routeflow restore 1 \"<time just before, UTC>\""
}

# ---- M. What an upgrade would do, without doing it ---------------------------------------------------
cmd_upgrade_check() {
  local tarball=${1:?usage: routeflow upgrade --check <tarball>} version arch tmp name f kind safe=1 n=0
  read -r version arch < <(parse_tarball_name "$tarball") || die "not a release tarball name: $(basename "$tarball")"
  [ "$arch" = "$(machine_arch)" ] || die "$(basename "$tarball") is for $arch, this machine is $(machine_arch)"
  verify_checksum "$tarball" || die "the checksum does not match"
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
  tar -xzf "$tarball" -C "$tmp" --strip-components=1 --wildcards '*/db/migrations/*'
  chmod -R a+rX "$tmp"
  echo "Release:   $(current_version || true) -> $version"
  echo "Disk:      $(df -Pk "$ROOT" | awk 'NR==2 {print int($4/1048576)}') GB free (an upgrade needs ${MIN_FREE_GB:-3})"
  echo "Database changes:"
  while read -r name; do
    [ -n "$name" ] || continue
    f=$tmp/db/migrations/$name.sql; n=$((n + 1))
    kind=$(head -20 "$f" | sed -n 's/^--[[:space:]]*rf:[[:space:]]*\(expand-only\|contract\).*/\1/p' | head -1)
    [ "$kind" = expand-only ] || safe=0
    echo "  $name   ${kind:-unmarked}"
  done < <(pending_migrations "$tmp")
  [ "$n" -gt 0 ] || echo "  none"
  if [ "$safe" = 1 ]; then
    echo "If it fails its checks, it switches back to the live release by itself."
  else
    echo "A change above alters existing data or columns: if it fails, it stops and waits for you (no automatic switch back)."
  fi
}

