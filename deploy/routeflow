#!/usr/bin/env bash
# routeflow: the one command for a RouteFlow server. Install a fresh server, upgrade to a release,
# roll back, check, back up, restore, read logs. Run with no arguments on a terminal for a menu.
#
#   sudo bash install.sh                                      # fresh server: checks the file, asks the questions
#   sudo routeflow install [tarball]                          # the same questions; runs in the background
#   sudo DOMAIN=app.example.ir routeflow install --yes        # no questions; tarball from incoming/ or here
#   sudo routeflow first-login | support-file                 # the first login again | one file to send for help
#   sudo routeflow upgrade routeflow-0.2.0-linux-x64.tar.gz   # upgrade now (otherwise: tonight, below)
#   sudo routeflow rollback | status | backup [full|diff|incr] | restore-drill | restore | logs
#   sudo routeflow doctor | install-report | check-pi         # checks any time | the final check again | the Pi link
#   sudo routeflow cdn-ips [--open|--only]                    # refresh Arvan's address list | open the web ports | Arvan only
#   sudo routeflow arvan-probe [domain]                       # read-only: what the saved Arvan key can reach (paste the report)
#   sudo routeflow export [--anonymise] [--encrypt] [file] | import <file> | sql <fix.sql>
#   sudo routeflow upgrade --check <tarball> | maintenance on|off | reset-login <user>
#   sudo routeflow rebuild <secrets.tar.asc> [tarball]        # a new server from the secrets copy and the Pi
#   sudo routeflow support-key add "<ssh key>" 3d | list | remove   # a helper's key that expires by itself
#   sudo routeflow secrets list | set KEY | unset KEY | backup [file] | restore <file>
#   routeflow upgrade-scheduled                               # the nightly timer: newest tarball in incoming/
#   sudo routeflow                                            # Whiptail menu
#
# A release tarball (scripts/release/pack.sh) holds the built app, its own Node, the migrations and
# the server scripts. Releases live in $ROOT/releases/<version>; $ROOT/current points at the live one;
# photos and map tiles live in $ROOT/data and survive every upgrade. Answers to the install questions
# are kept in /etc/routeflow/routeflow.conf, and every other config file is written from it.
#
# The menu only calls these same commands: whatever GitHub runs, the menu runs too.

set -euo pipefail

ROOT=${ROUTEFLOW_ROOT:-/opt/routeflow}
CONF_DIR=${ROUTEFLOW_CONF_DIR:-/etc/routeflow}
CADDY_DIR=${ROUTEFLOW_CADDY_DIR:-/etc/caddy}
CONF=$CONF_DIR/routeflow.conf
ENV_FILE=$CONF_DIR/env
SECRETS=$CONF_DIR/secrets.cred
APP_USER=routeflow
DB_NAME=routeflow
SERVICE=routeflow
LOCK=/run/lock/routeflow.lock

say() { printf '== %s\n' "$*"; }
warn() { printf 'routeflow: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

# The install's numbered headings: "[4/11] Firewall". STEP_TOTAL is the number of step calls in cmd_install
# (a test keeps them equal).
STEP_TOTAL=11
STEP_N=0
STEP_T=0; STEP_PREV=""; STEP_TIMES=()
progress_bar() { local n=$1 t=$2 w=10 f i b=""; f=$((n * w / t)); for ((i = 0; i < w; i++)); do if ((i < f)); then b+="█"; else b+="░"; fi; done; printf '%s' "$b"; }
# step N: closes the timing of the one before, prints "== [████░░░░░░] 4/11 name".
step() {
  local now; now=$(date +%s)
  if [ -n "$STEP_PREV" ]; then STEP_TIMES+=("$((now - STEP_T)) s  $STEP_PREV"); fi
  STEP_T=$now; STEP_PREV=$*
  STEP_N=$((STEP_N + 1))
  printf '== [%s] %s/%s %s%s\n' "$(progress_bar "$STEP_N" "$STEP_TOTAL")" "$STEP_N" "$STEP_TOTAL" "$*" "$(time_left "$now")"
}
# A rough guess, from how long the finished steps took against their usual share of the whole install.
# shortcut: the shares are my estimate for a 4 GB VPS, not measured; re-weigh them after the first real run.
STEP_WEIGHTS=(1 30 2 6 18 4 2 15 2 10 2)
time_left() {
  local now=$1 i done_w=0 total_w=0 elapsed left
  [ -n "${INSTALL_T0:-}" ] || return 0
  for ((i = 0; i < STEP_TOTAL; i++)); do
    total_w=$((total_w + ${STEP_WEIGHTS[i]:-1}))
    if ((i < STEP_N - 1)); then done_w=$((done_w + ${STEP_WEIGHTS[i]:-1})); fi
  done
  elapsed=$((now - INSTALL_T0))
  [ "$done_w" -gt 0 ] && [ "$elapsed" -ge 20 ] || return 0
  left=$(( elapsed * (total_w - done_w) / done_w ))
  printf '  (about %s min left)' "$(( (left + 59) / 60 ))"
}
# 23: the terminal's title tells the state, so you can work in another window meanwhile.
set_title() { { printf '\033]0;%s\007' "$1" >/dev/tty; } 2>/dev/null || true; }  # the braces keep bash's own "no tty" error quiet
step_times() {
  local now t; now=$(date +%s)
  [ -z "$STEP_PREV" ] || STEP_TIMES+=("$((now - STEP_T)) s  $STEP_PREV"); STEP_PREV=""
  printf '\nTime per step\n'; for t in "${STEP_TIMES[@]}"; do printf '  %s\n' "$t"; done
}
# Only the package download is skipped when an install is run again: it is the slow part, and it needs no
# answer from the questions. Everything else is re-applied from $CONF, which is fast.
step_done() { [ "${ROUTEFLOW_FRESH:-0}" != 1 ] && grep -qx "$1" "$CONF_DIR/install-steps" 2>/dev/null; }
mark_step() { echo "$1" >> "$CONF_DIR/install-steps"; }

# x86_64 servers take the x64 tarball, ARM machines (the Pi, ARM VPSes) the arm64 one.
machine_arch() {
  case "${1:-$(uname -m)}" in
    x86_64 | amd64) echo x64 ;;
    aarch64 | arm64) echo arm64 ;;
    *) return 1 ;;
  esac
}

# routeflow-0.2.0-linux-arm64.tar.gz -> "0.2.0 arm64"; anything else is refused.
parse_tarball_name() {
  local base
  base=$(basename "$1")
  [[ $base =~ ^routeflow-([0-9]+\.[0-9]+\.[0-9]+)-linux-(x64|arm64)\.tar\.gz$ ]] || return 1
  echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
}

# The tarball must sit next to its .sha256 file, and the sum must match.
verify_checksum() {
  local tarball=$1 sumfile="$1.sha256" want got
  [ -f "$sumfile" ] || { warn "no checksum file $sumfile"; return 1; }
  want=$(awk '{print $1; exit}' "$sumfile")
  got=$(sha256sum "$tarball" | awk '{print $1}')
  [ -n "$want" ] && [ "$want" = "$got" ] || { warn "checksum does not match for $(basename "$tarball")"; return 1; }
}

current_version() { [ -L "$ROOT/current" ] && basename "$(readlink -f "$ROOT/current")" || true; }

# Newest first, by the time each release was unpacked.
list_releases() { [ -d "$ROOT/releases" ] && ls -1t "$ROOT/releases" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true; }

# The release to fall back to: the newest one that is not live.
previous_release() {
  local live
  live=$(current_version)
  list_releases | grep -vxF "${live:-}" | head -1
}

# Keep the live release and the newest others up to KEEP_RELEASES in all.
prune_releases() {
  local keep=${KEEP_RELEASES:-3} live n=0 r
  live=$(current_version)
  for r in $(list_releases); do
    if [ "$r" = "$live" ]; then continue; fi
    n=$((n + 1))
    if [ "$n" -ge "$keep" ]; then rm -rf "${ROOT:?}/releases/$r"; fi
  done
}

# Unpacks into releases/<version> (via a temporary folder, so a half-unpacked release never exists)
# and links the shared data folders into it. Prints the version.
unpack_release() {
  local tarball=$1 version arch here tmp
  read -r version arch < <(parse_tarball_name "$tarball") || die "not a release tarball name: $(basename "$tarball")"
  here=$(machine_arch) || die "unsupported machine type $(uname -m)"
  [ "$arch" = "$here" ] || die "$(basename "$tarball") is for $arch, this machine is $here"
  verify_checksum "$tarball" || die "refusing an unverified release"
  if [ -e "$ROOT/releases/$version" ]; then
    # A first install that stopped (say, at the migrations) leaves its release folder and no live release: start it over.
    [ -z "$(current_version)" ] || die "release $version is already unpacked; use: routeflow switch $version"
    rm -rf "${ROOT:?}/releases/$version"
  fi
  mkdir -p "$ROOT/releases"
  tmp=$(mktemp -d "$ROOT/releases/.unpack.XXXXXX")
  tar -xzf "$tarball" -C "$tmp" --strip-components=1
  [ -x "$tmp/node/bin/node" ] && [ -f "$tmp/server.js" ] && [ "$(cat "$tmp/VERSION")" = "$version" ] \
    || { rm -rf "$tmp"; die "$(basename "$tarball") is incomplete"; }
  # Photos, avatars, map tiles, the 7-day file cache and uploads held while a bucket is down are
  # state, not code: one copy in $ROOT/data, linked into each release. The app writes cache and held
  # under its own folder, and a release folder is root-owned and replaced on every upgrade.
  local d
  for d in photos map cache held; do
    mkdir -p "$ROOT/data/$d"
    rm -rf "${tmp:?}/data/$d"
    ln -s "$ROOT/data/$d" "$tmp/data/$d"
  done
  chmod 755 "$tmp" # mktemp makes it 700, root only: the app user could not open its own release
  mv "$tmp" "$ROOT/releases/$version"
  echo "$version"
}

# Migrations in the release that the database has not run yet, one name per line.
pending_migrations() {
  local rel=$1 applied
  applied=$(as_app psql -X -qtA "postgres:///$DB_NAME?host=/var/run/postgresql" \
    -c "SELECT name FROM pgmigrations" 2>/dev/null || true)
  for f in "$rel"/db/migrations/*.sql; do
    local name
    name=$(basename "$f" .sql)
    grep -qxF "$name" <<<"$applied" || echo "$name"
  done
}

# True when every named migration says, in its header, that it only adds (scripts/check-migrations.mjs
# holds the rule in CI). Only then is it safe to put the previous release back on this database.
all_expand_only() {
  local rel=$1 name
  shift
  for name in "$@"; do
    head -20 "$rel/db/migrations/$name.sql" | grep -q '^-- rf: expand-only' || return 1
  done
}

as_app() { if [ "$(id -un)" = "$APP_USER" ]; then "$@"; else runuser -u "$APP_USER" -- "$@"; fi; }

run_migrations() {
  local rel=$1
  as_app env DATABASE_URL="postgres:///$DB_NAME?host=/var/run/postgresql" \
    "$rel/node/bin/node" "$rel/tools/node_modules/node-pg-migrate/bin/node-pg-migrate.js" up -m "$rel/db/migrations"
}

app_port() { echo "${APP_PORT:-3003}"; }

# Waits up to 60 s for /api/health to answer {"ok":true} with the expected version (any, if none given).
wait_healthy() {
  local want=${1:-} i body
  for i in $(seq 1 30); do
    body=$(curl -fsS --max-time 3 "http://127.0.0.1:$(app_port)/api/health" 2>/dev/null || true)
    if grep -q '"ok":true' <<<"$body" && { [ -z "$want" ] || grep -qF "\"version\":\"$want\"" <<<"$body"; }; then return 0; fi
    sleep 2
  done
  return 1
}

# After an upgrade, more than the database ping: the sign-in page renders, a script it links loads,
# and, when a smoke login is set up (SMOKE_USER in the config, SMOKE_PASSWORD in the secrets), a
# signed-in list answers. Prints what failed.
smoke_check() {
  local base="http://127.0.0.1:$(app_port)" page asset jar ok=0
  page=$(curl -fsS --max-time 10 "$base/login" 2>/dev/null) && grep -qi '<html' <<<"$page" || { warn "smoke: /login did not render"; return 1; }
  asset=$(grep -o '/_next/static/[^"]*\.js' <<<"$page" | head -1)
  [ -n "$asset" ] && curl -fsS --max-time 10 -o /dev/null "$base$asset" || { warn "smoke: $asset did not load"; return 1; }
  if [ -n "${SMOKE_USER:-}" ] && [ -n "${SMOKE_PASSWORD:-}" ]; then
    jar=$(mktemp)
    # The body goes through stdin and JSON.stringify: no password on a command line, no quoting bugs.
    if SMOKE_USER=$SMOKE_USER SMOKE_PASSWORD=$SMOKE_PASSWORD "$ROOT/current/node/bin/node" -e 'console.log(JSON.stringify({ username: process.env.SMOKE_USER, password: process.env.SMOKE_PASSWORD }))' \
         | curl -fsS --max-time 10 -c "$jar" -H 'content-type: application/json' --data @- "$base/api/login" -o /dev/null \
       && curl -fsS --max-time 10 -b "$jar" "$base/api/me" | grep -q '"ok":true' \
       && curl -fsS --max-time 20 -b "$jar" -o /dev/null "$base/api/customers"; then ok=1; fi
    rm -f "$jar"
    [ "$ok" = 1 ] || { warn "smoke: signed-in check as $SMOKE_USER failed (login, /api/me or /api/customers)"; return 1; }
  fi
  return 0
}

switch_to() {
  local version=$1
  [ -d "$ROOT/releases/$version" ] || die "no release $version in $ROOT/releases"
  ln -sfn "releases/$version" "$ROOT/current.new"
  mv -T "$ROOT/current.new" "$ROOT/current"
  systemctl restart "$SERVICE"
}

# ---- Secrets ---------------------------------------------------------------------------------------
# Passwords, keys and tokens live in $SECRETS, encrypted with systemd-creds (this machine's key, and
# its TPM when it has one), never in a plain file. systemd decrypts it only for the app and the backup
# units (LoadCredentialEncrypted), which read it with node --env-file. Everything else stays in the
# plain $ENV_FILE. A copy for rebuilding the server elsewhere is gpg-encrypted with a passphrase
# (routeflow secrets backup) and kept in the private repo, since this machine's key dies with it.

# A key whose value is a secret: moved out of the plain env file.
is_secret_key() { [[ $1 =~ ^(DATABASE_URL|SESSION_SECRET)$ || $1 =~ _(TOKEN|PASSWORD|PASS|SECRET|KEY|APIKEY)$ ]]; }

# Splits an env file into its plain lines (comments too) and its secret lines.
split_env() {
  local in=$1 plain=$2 secret=$3 line
  : >"$plain"; : >"$secret"
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]] && is_secret_key "${BASH_REMATCH[1]}"; then
      printf '%s\n' "$line" >>"$secret"
    else
      printf '%s\n' "$line" >>"$plain"
    fi
  done <"$in"
}

# KEY=value lines of both files, one per key; the second file wins.
merge_env() { awk 'FNR==NR && /^[A-Za-z_][A-Za-z0-9_]*=/ {k=$0; sub(/=.*/,"",k); seen[k]=1; print; next}
  FNR!=NR && /^[A-Za-z_][A-Za-z0-9_]*=/ {k=$0; sub(/=.*/,"",k); if (!(k in seen)) print}' "$2" "$1"; }

# A private scratch folder in RAM, so a decrypted copy never reaches the disk.
secret_tmp() { mktemp -d -p /run routeflow-secrets.XXXXXX; }

secrets_read() { [ -f "$SECRETS" ] && systemd-creds decrypt --name=secrets "$SECRETS" - || true; }

secrets_write() {
  install -d -m 755 "$CONF_DIR"
  systemd-creds encrypt --name=secrets "$1" "$SECRETS.new" && chmod 600 "$SECRETS.new" && mv -f "$SECRETS.new" "$SECRETS"
}

secret_value() { secrets_read | sed -n "s/^$1=//p" | tail -1; }

# Moves any secret lines left in the plain env file (a first install writes them there) into
# $SECRETS. Values already in $SECRETS win, so a restored copy keeps its SESSION_SECRET.
secrets_absorb() {
  local t
  [ -f "$ENV_FILE" ] || return 0
  t=$(secret_tmp)
  split_env "$ENV_FILE" "$t/plain" "$t/new"
  if [ -s "$t/new" ]; then
    secrets_read >"$t/old"
    merge_env "$t/new" "$t/old" >"$t/all"
    secrets_write "$t/all"
    install -m 640 -g "$APP_USER" "$t/plain" "$ENV_FILE"
    say "Moved $(wc -l <"$t/new") secret(s) from $ENV_FILE into $SECRETS"
  fi
  rm -rf "$t"
  # install.sh's copy of the web role's password; it is inside DATABASE_URL now.
  rm -f "$CONF_DIR/web-role-pass"
}

cmd_secrets() {
  need_root secrets
  local action=${1:-list} key value t out
  case "$action" in
    list) secrets_read | sed -n 's/=.*//p' ;;
    set)
      key=${2:?usage: routeflow secrets set KEY (the value is asked, never typed on the command line)}
      [[ $key =~ ^[A-Z][A-Z0-9_]*$ ]] || die "a key is upper case letters, digits and _"
      if [ -t 0 ]; then read -rsp "Value for $key: " value; echo; else IFS= read -r value; fi
      [ -n "$value" ] || die "empty value; nothing changed"
      t=$(secret_tmp)
      secrets_read >"$t/old"
      printf '%s=%s\n' "$key" "$value" >"$t/new"
      merge_env "$t/old" "$t/new" >"$t/all"
      secrets_write "$t/all"; rm -rf "$t"
      say "$key saved"
      systemctl try-restart "$SERVICE" ;;
    unset)
      key=${2:?usage: routeflow secrets unset KEY}
      t=$(secret_tmp)
      secrets_read | grep -v "^$key=" >"$t/all" || true
      secrets_write "$t/all"; rm -rf "$t"
      say "$key removed"
      systemctl try-restart "$SERVICE" ;;
    backup)
      # Everything a rebuilt server needs that is not in the database backups: the secrets, the
      # install answers, the backup encryption passphrase and the backup machine's SSH key.
      out=${2:-$PWD/routeflow-secrets-$(hostname -s)-$(date +%F).tar.asc}
      [ -f "$SECRETS" ] || die "no secrets yet"
      t=$(secret_tmp)
      secrets_read >"$t/secrets.env"
      [ -f "$CONF" ] && cp "$CONF" "$t/routeflow.conf"
      [ -f /etc/pgbackrest/cipher-pass ] && cp /etc/pgbackrest/cipher-pass "$t/cipher-pass"
      key=$(getent passwd postgres | cut -d: -f6)/.ssh/routeflow_backup
      [ -f "$key" ] && cp "$key" "$t/routeflow_backup" && cp "$key.pub" "$t/routeflow_backup.pub"
      say "Choose a passphrase you keep outside this server (a password manager)."
      tar -C "$t" -c . | gpg --pinentry-mode loopback --symmetric --cipher-algo AES256 --armor -o "$out"
      rm -rf "$t"; chmod 600 "$out"
      say "Wrote $out. Put it in the private repo; it opens only with that passphrase." ;;
    restore)
      [ -f "${2:-}" ] || die "usage: routeflow secrets restore <routeflow-secrets-....tar.asc>"
      t=$(secret_tmp)
      gpg --pinentry-mode loopback -q -d -o "$t/blob" "$2"
      if tar -tf "$t/blob" >/dev/null 2>&1; then
        tar -xf "$t/blob" -C "$t"
        secrets_write "$t/secrets.env"
        if [ -f "$t/routeflow.conf" ]; then install -d -m 755 "$CONF_DIR"; install -m 644 "$t/routeflow.conf" "$CONF"; fi
        if [ -f "$t/cipher-pass" ]; then
          install -d -m 750 /etc/pgbackrest; install -m 600 "$t/cipher-pass" /etc/pgbackrest/cipher-pass
          if id postgres >/dev/null 2>&1; then chown postgres:postgres /etc/pgbackrest/cipher-pass; fi
        fi
        if [ -f "$t/routeflow_backup" ]; then install -d -m 700 /root/.routeflow-restore; cp "$t"/routeflow_backup* /root/.routeflow-restore/; fi
      else
        secrets_write "$t/blob"   # an older copy: the secrets alone
      fi
      rm -rf "$t"
      say "Secrets restored for this machine"
      systemctl try-restart "$SERVICE" 2>/dev/null || true ;;
    *) die "routeflow secrets list | set KEY | unset KEY | backup [file] | restore <file>" ;;
  esac
}

load_conf() { if [ -f "$CONF" ]; then . "$CONF"; fi; }

# J. An upgrade unpacks about 400 MB and a backup runs first; with less room it would stop halfway.
enough_disk() { [ "$(df -Pk "$ROOT" 2>/dev/null | awk 'NR==2 {print int($4/1048576)}')" -ge "${MIN_FREE_GB:-3}" ]; }

need_root() { [ "$(id -u)" = 0 ] || die "run as root: sudo routeflow $*"; }

cmd_upgrade() {
  if [ "${1:-}" = --check ]; then shift; load_conf; cmd_upgrade_check "$@"; return; fi
  local tarball=${1:?usage: routeflow upgrade <routeflow-X.Y.Z-linux-ARCH.tar.gz>} from version pending
  need_root upgrade
  load_conf
  exec 9>"$LOCK"; flock -n 9 || die "another routeflow command is running"
  enough_disk || die "less than ${MIN_FREE_GB:-3} GB free on $ROOT; nothing was changed. Free space (old releases: routeflow status), then try again."
  from=$(current_version)
  version=$(unpack_release "$tarball")
  say "Release $version unpacked (live: ${from:-none})"
  if [ -n "$from" ] && [ -f /etc/systemd/system/routeflow-backup@.service ]; then
    say "Backup before the upgrade"
    systemctl start routeflow-backup@incr || die "the backup failed; nothing was changed. Fix it or rerun with a working backup."
  fi
  mapfile -t pending < <(pending_migrations "$ROOT/releases/$version")
  say "Migrations to run: ${#pending[@]}"
  run_migrations "$ROOT/releases/$version" || die "migrations failed; the live release ($from) was not touched. Read the error above."
  say "Starting $version"
  switch_to "$version"
  SMOKE_PASSWORD=${SMOKE_PASSWORD:-$(secret_value SMOKE_PASSWORD)}
  if wait_healthy "$version" && smoke_check; then
    say "$version is live (was ${from:-none}). Migrations applied: ${#pending[@]}${pending[*]:+ (${pending[*]})}"
    prune_releases
    return 0
  fi
  warn "$version failed its checks (health within 60 s, then the smoke check)"
  if [ -z "$from" ]; then die "first install: nothing to go back to. See: routeflow logs"; fi
  if [ "${#pending[@]}" = 0 ] || all_expand_only "$ROOT/releases/$version" "${pending[@]}"; then
    warn "switching back to $from (the new migrations only add, so $from can run on this database)"
    switch_to "$from"
    wait_healthy "$from" && die "back on $from; $version stays unpacked for a look: routeflow logs" || die "$from is not healthy either. See: routeflow logs"
  fi
  die "NOT switching back: a migration in $version changes existing data or columns, so $from may not run on this database. $version is still live and unhealthy. See: routeflow logs, then decide."
}

# Run by routeflow-upgrade.timer (UPGRADE_AT, default 03:30 Tehran = 00:00 UTC). GitHub's deploy job
# only drops a tarball and its .sha256 in $ROOT/incoming; the upgrade itself waits for the quiet hour.
newest_incoming() {
  local arch best="" bestv="" f v a
  arch=$(machine_arch) || return 0
  for f in "$ROOT"/incoming/routeflow-*-linux-"$arch".tar.gz; do
    # A tarball still being copied has no .sha256 yet (the deploy job sends it last).
    [ -f "$f" ] && [ -f "$f.sha256" ] || continue
    read -r v a < <(parse_tarball_name "$f") || continue
    if [ -z "$bestv" ] || [ "$(printf '%s\n%s\n' "$bestv" "$v" | sort -V | tail -1)" = "$v" ]; then best=$f; bestv=$v; fi
  done
  echo "$best"
}

cmd_upgrade_scheduled() {
  local next live v a
  next=$(newest_incoming)
  [ -n "$next" ] || { say "nothing waiting in $ROOT/incoming"; return 0; }
  read -r v a < <(parse_tarball_name "$next")
  live=$(current_version)
  if [ -n "$live" ] && [ "$(printf '%s\n%s\n' "$live" "$v" | sort -V | tail -1)" = "$live" ]; then
    say "$v is not newer than the live $live; nothing to do"
    return 0
  fi
  [ ! -d "$ROOT/releases/$v" ] || { say "$v was already tried (it is in releases/); not retrying on schedule"; return 0; }
  cmd_upgrade "$next"
}

cmd_rollback() {
  local to from
  need_root rollback
  load_conf
  exec 9>"$LOCK"; flock -n 9 || die "another routeflow command is running"
  from=$(current_version)
  to=${1:-$(previous_release)}
  [ -n "$to" ] || die "no earlier release on this machine"
  say "Rolling back $from -> $to (the database is not rolled back)"
  switch_to "$to"
  wait_healthy "$to" && say "$to is live" || die "$to did not become healthy. See: routeflow logs"
}

cmd_status() {
  load_conf
  local live
  live=$(current_version)
  echo "Release:   ${live:-none}   (on disk: $(list_releases | tr '\n' ' '))"
  echo "Service:   $(systemctl is-active "$SERVICE" 2>/dev/null || true)"
  if curl -fsS --max-time 3 "http://127.0.0.1:$(app_port)/api/health" >/dev/null 2>&1; then echo "Health:    ok"; else echo "Health:    NOT ANSWERING"; fi
  echo "Disk:      $(df -h --output=pcent "$ROOT" 2>/dev/null | tail -1 | tr -d ' ') used on $ROOT"
  if [ -f /var/lib/routeflow/backups/backup-status.json ]; then
    echo "Backup:    last status written $(date -r /var/lib/routeflow/backups/backup-status.json '+%Y-%m-%d %H:%M')"
  else
    echo "Backup:    no backup status yet"
  fi
  if [ -n "$live" ] && [ -f "$ENV_FILE" ] && [ "$(id -u)" = 0 ]; then
    echo "Database check:"
    local t; t=$(secret_tmp); secrets_read >"$t/secrets"; chown -R "$APP_USER" "$t"
    ( cd "$ROOT/current" && set -a && . "$ENV_FILE" && set +a \
      && as_app env PG_APP_ROLE=routeflow_app "$ROOT/current/node/bin/node" --env-file="$t/secrets" scripts/pg/doctor.mjs ) || true
    rm -rf "$t"
  fi
}

cmd_backup() {
  need_root backup
  local kind=${1:-incr}
  case "$kind" in full | diff | incr) ;; *) die "backup type is full, diff or incr" ;; esac
  systemctl start "routeflow-backup@$kind" && say "$kind backup done"
}

cmd_restore_drill() { need_root restore-drill; systemctl start routeflow-restore-drill && say "restore drill done; see /var/lib/routeflow/backups/restore-drill.json"; }

# Replaces the live database with a backup. The current data folder is moved aside, never deleted.
cmd_restore() {
  need_root restore
  local repo=${1:-} target=${2:-} pgdata stamp
  [ -n "$repo" ] || die "usage: routeflow restore <1|2> [\"YYYY-MM-DD HH:MM:SS+00\"]   (1 = this machine, 2 = the second machine)"
  pgdata=$(runuser -u postgres -- psql -X -qtA -c "SHOW data_directory")
  stamp=$(date +%Y%m%d-%H%M%S)
  if [ -t 0 ]; then
    read -r -p "This stops the app and replaces the database with backup repo $repo${target:+ at $target}. Type RESTORE to go on: " answer
    [ "$answer" = RESTORE ] || die "nothing changed"
  elif [ "${ROUTEFLOW_YES:-}" != 1 ]; then
    die "not on a terminal: set ROUTEFLOW_YES=1 to confirm"
  fi
  systemctl stop "$SERVICE" || true
  systemctl stop postgresql
  mv "$pgdata" "$pgdata.before-restore-$stamp"
  install -d -o postgres -g postgres -m 700 "$pgdata"
  if [ -n "$target" ]; then
    runuser -u postgres -- pgbackrest --stanza=routeflow --repo="$repo" --type=time "--target=$target" --target-action=promote restore
  else
    runuser -u postgres -- pgbackrest --stanza=routeflow --repo="$repo" restore
  fi
  systemctl start postgresql
  systemctl start "$SERVICE"
  say "Restored. The old data folder is at $pgdata.before-restore-$stamp; delete it once you are happy."
  cmd_status
}

cmd_logs() {
  journalctl -u "$SERVICE" -n "${1:-100}" --no-pager || true
  journalctl -u caddy -n 20 --no-pager --priority=warning || true
}

# Asks once and remembers the answers in $CONF. On a terminal it uses Whiptail; otherwise the values
# must already be in $CONF or the environment.
# With --yes (ROUTEFLOW_YES=1) or no terminal, nothing is asked: the value comes from $CONF, the
# environment or the default.
# Interactive only on a terminal and without --yes. Prompts go to the terminal itself (not the install
# log); a plain read works over SSH, with paste, and before whiptail is installed.
interactive() { [ "${ROUTEFLOW_YES:-0}" != 1 ] && [ -t 0 ] && [ -w /dev/tty ]; }

ask() {
  local var=$1 question=$2 default=${3:-} value
  value=${!var:-$default}
  if interactive; then
    printf '\n%s\n' "$question" >/dev/tty
    read -r -p "  [${value:-empty}] > " -e reply </dev/tty || die "cancelled"
    [ -z "$reply" ] || value=$reply
  fi
  printf -v "$var" '%s' "$value"
}

# ask_yes VAR "question" 1|0 : stores 1 or 0 (Enter keeps the default).
ask_yes() {
  local var=$1 question=$2 default=${3:-1} reply
  if interactive; then
    printf '\n%s\n' "$question" >/dev/tty
    read -r -p "  [$([ "$default" = 1 ] && echo Y/n || echo y/N)] > " reply </dev/tty || die "cancelled"
    case "$reply" in [yYبه]*) default=1 ;; [nNخن]*) default=0 ;; esac
  fi
  printf -v "$var" '%s' "$default"
}

valid_domain() { [[ $1 =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]]; }
valid_username() { [[ $1 =~ ^[A-Za-z0-9._-]{3,32}$ ]]; }
valid_host() { [[ $1 =~ ^[A-Za-z0-9._:-]+$ ]]; }
# An empty key is fine (the question can be skipped).
valid_pubkey() { [ -z "$1" ] || [[ $1 =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521))\ [A-Za-z0-9+/=]+(\ .*)?$ ]]; }
reachable() { timeout 6 bash -c "exec 3<>/dev/tcp/$1/${2:-22}" 2>/dev/null; }

# Like ask, but asks again until "$check" accepts the answer. Interactive use only.
ask_valid() {
  local var=$1 question=$2 default=$3 check=$4 hint=$5
  while :; do
    ask "$var" "$question" "$default"
    if "$check" "${!var}"; then return 0; fi
    printf '   That does not look right: %s\n' "$hint" >/dev/tty
    printf -v "$var" '%s' ""; default=""
  done
}

q1() { ask_valid DOMAIN "1. What address will people open?  Example: app.example.ir
   (Create this name in the Arvan CDN panel first, pointing at this server's IP.)" "${DOMAIN:-}" valid_domain "a name like app.example.ir"; }
q2() { ask COMPANY_NAME "2. Company name shown in the app.  Example: پخش نمونه" "${COMPANY_NAME:-}"; }
q3() { ask_valid OWNER_USER "3. Username for the first login (you, the platform owner)." "${OWNER_USER:-admin}" valid_username "3 to 32 letters, digits, dot, dash or underscore"; }
q4() {
  [ "${PW_PRESET:-0}" != 1 ] || return 0
  local again
  while :; do
    printf '\n4. Password for the first login.\n   Press Enter to let me make a strong random one and show it once at the end.\n' >/dev/tty
    read -r -s -p "  > " OWNER_PASSWORD </dev/tty || die "cancelled"; printf '\n' >/dev/tty
    [ -n "$OWNER_PASSWORD" ] || return 0
    if [ "${#OWNER_PASSWORD}" -lt 8 ]; then printf '   At least 8 characters, please.\n' >/dev/tty; continue; fi
    read -r -s -p "  Again > " again </dev/tty || die "cancelled"; printf '\n' >/dev/tty
    [ "$again" = "$OWNER_PASSWORD" ] && return 0
    printf '   The two did not match.\n' >/dev/tty
  done
}
q5() {
  local c
  printf '\n5. Which certificate does this server use toward Arvan?\n   1 = Caddy makes its own (simplest: in the Arvan panel set SSL to "do not verify the origin")\n   2 = Let'"'"'s Encrypt, or an Arvan origin certificate you put in %s/tls/ (origin.crt, origin.key)\n' "$CONF_DIR" >/dev/tty
  read -r -p "  [1] > " c </dev/tty || die "cancelled"
  case "$c" in 2) CERT_MODE=auto ;; *) CERT_MODE=internal ;; esac
}
q6() { ask_yes CDN_ONLY "6. Open the web ports only to Arvan's servers? (safer; choose no while you test without the CDN)" "${CDN_ONLY:-1}"; }
q7() {
  local pi=0 go
  [ -z "${OFFSITE_HOST:-}" ] || pi=1
  ask_yes pi "7. Send backups to a second machine (your home Pi)? You can say no now and add it later." "$pi"
  if [ "$pi" != 1 ]; then OFFSITE_HOST=""; return 0; fi
  while :; do
    ask_valid OFFSITE_HOST "   Pi address (host name or IP)." "${OFFSITE_HOST:-}" valid_host "a host name or an IP address, no spaces"
    reachable "$OFFSITE_HOST" && break
    go=0
    ask_yes go "   I cannot reach $OFFSITE_HOST on port 22 from here. Use it anyway?" 0
    [ "$go" = 1 ] && break
    OFFSITE_HOST=""
  done
  ask OFFSITE_USER "   User on the Pi for the backups." "${OFFSITE_USER:-rfbackup}"
  ask OFFSITE_PATH "   Folder on the Pi for the backups." "${OFFSITE_PATH:-/srv/routeflow-pgbackrest}"
}
q8() { ask_valid DEPLOY_PUBKEY "8. Should GitHub upload new versions by itself? Paste its public key (starts with ssh-ed25519), or press Enter to skip.
   Skipping is fine: you can copy the release file by hand." "${DEPLOY_PUBKEY:-}" valid_pubkey "a public key line such as: ssh-ed25519 AAAA... name"; }

q9() {
  local k
  printf '\n9. Arvan API key (optional). With it I add the A record for the address in Arvan myself and keep the key for the app,\n   which then sets up each company address. Press Enter to skip (nothing is asked again; a saved key stays).\n' >/dev/tty
  read -r -s -p "  > " k </dev/tty || die "cancelled"; printf '\n' >/dev/tty
  [ -z "$k" ] || ARVAN_API_KEY=$k
}

answers_summary() {
  printf '\n---- Summary ----\n'
  printf ' 1 Address:      %s\n 2 Company:      %s\n 3 First login:  %s\n' "$DOMAIN" "${COMPANY_NAME:-(none)}" "$OWNER_USER"
  printf ' 4 Password:     %s\n' "$([ -n "${OWNER_PASSWORD:-}" ] && echo "your own" || echo "a random one, shown once at the end")"
  printf ' 5 Certificate:  %s\n 6 Arvan only:   %s\n' "$([ "$CERT_MODE" = internal ] && echo "Caddy's own" || echo "Let's Encrypt / origin certificate")" "$([ "$CDN_ONLY" = 1 ] && echo yes || echo no)"
  printf ' 7 Backup Pi:    %s\n 8 GitHub key:  %s\n 9 Arvan key:    %s\n' "${OFFSITE_HOST:-no (this server only)}" "$([ -n "${DEPLOY_PUBKEY:-}" ] && echo yes || echo no)" "$([ -n "${ARVAN_API_KEY:-}" ] && echo "yes (the A record is made for you)" || echo "no (you add the A record by hand)")"
}

# The questions of a hand-run install, in the order a person thinks about them. With --yes the answers
# come from the environment or $CONF and nothing is asked.
install_questions() {
  interactive || return 0
  local c
  [ -z "${OWNER_PASSWORD:-}" ] || PW_PRESET=1
  {
    printf '\n==== RouteFlow install: a few questions ====\n'
    printf 'Press Enter to keep the answer shown in [brackets]. You can change any answer before it starts.\n'
  } >/dev/tty
  q1; q2; q3; q4; q5; q6; q7; q8; q9
  while :; do
    answers_summary >/dev/tty
    printf '\nPress Enter to start (about 10 minutes), a number 1 to 9 to change that answer, or Q to quit.\n' >/dev/tty
    read -r -p "  [start] > " c </dev/tty || die "cancelled"
    case "$c" in
      "" | [yYبه]*) break ;;
      [qQ]*) die "stopped, nothing was changed" ;;
      [1-9]) if [ "$c" = 4 ]; then PW_PRESET=0; fi; "q$c" ;;
    esac
  done
}

write_conf() {
  install -d -m 755 "$CONF_DIR"
  ( umask 022
    cat > "$CONF" <<CONF
