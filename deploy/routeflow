# ---- Running inside Iran: mirror, clock, CDN-only firewall, certificate, doctor, login status ------

# A. OS packages from Arvan's mirror inside Iran, so installs and security updates keep working when
# international internet is cut. Switched only when the mirror answers; the old list is kept.
# shortcut: PostgreSQL (PGDG) and Caddy still come from their own foreign repositories.
use_iran_mirror() {
  local mirror=${APT_MIRROR:-https://mirror.arvancloud.ir} f
  . /etc/os-release
  [ "$mirror" = off ] && return 0
  curl -fsS --max-time 10 -o /dev/null "$mirror/$ID/dists/$VERSION_CODENAME/Release" 2>/dev/null \
    || { warn "package mirror $mirror does not answer; keeping the current package sources"; return 0; }
  say "Packages from $mirror (inside Iran)"
  for f in /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do
    [ -f "$f" ] || continue
    [ -f "$f.before-routeflow" ] || cp -a "$f" "$f.before-routeflow"
    sed -i -E "s#https?://([a-z]{2}\\.)?(archive|security)\\.ubuntu\\.com/ubuntu/?#$mirror/ubuntu/#g; s#https?://deb\\.debian\\.org/debian/?#$mirror/debian/#g" "$f"
  done
  # A mirror that is missing a part (a security pocket) must not break apt: go back to the old lists.
  if ! apt-get update -q >/dev/null 2>&1; then
    warn "apt failed with $mirror; back to the original package sources"
    for f in /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do
      [ -f "$f.before-routeflow" ] && cp -a "$f.before-routeflow" "$f"
    done
  fi
}

# B. The clock from time servers inside Iran first: two-step codes (Google Authenticator) fail when
# the server is a minute off.
set_time_servers() {
  install -d /etc/systemd/timesyncd.conf.d
  printf '[Time]\nNTP=%s\nFallbackNTP=ntp.ubuntu.com time.cloudflare.com\n' "${NTP_SERVERS:-ir.pool.ntp.org}" \
    >/etc/systemd/timesyncd.conf.d/routeflow.conf
  timedatectl set-ntp true 2>/dev/null || true
  systemctl restart systemd-timesyncd 2>/dev/null || true
}

# C. Only Arvan's CDN may open the web ports, so nobody reaches the server around the CDN (and its
# protection) by its bare IP. The list is fetched from Arvan; when that fails the rules stay as they were.
CDN_IPS_URL=${CDN_IPS_URL:-https://www.arvancloud.ir/en/ips.txt}

# IPv4 and IPv6 ranges from a list, one per line; anything else is dropped.
parse_cdn_ips() { grep -Eo '^[0-9a-fA-F:.]+/[0-9]{1,3}' | sort -u; }

# Rule numbers (from `ufw status numbered` on stdin) to delete: web ports open to Anywhere, and
# routeflow-cdn ranges no longer in the list given.
stale_web_rules() {
  local list=$1 line num src
  while IFS= read -r line; do
    [[ $line =~ ^\[\ *([0-9]+)\]\ +([^ ]+)\ +ALLOW\ IN\ +([^ ]+) ]] || continue
    num=${BASH_REMATCH[1]}; src=${BASH_REMATCH[3]}
    if [[ ${BASH_REMATCH[2]} =~ ^(80|443)/tcp$ && $src == Anywhere ]]; then echo "$num"
    elif [[ $line == *routeflow-cdn* ]] && ! grep -qxF "$src" <<<"$list"; then echo "$num"; fi
  done
}

# Read-only: asks Arvan which parts of its CDN API this server's key can reach for the main domain and prints a
# short report (paths, answers, setting names; keys and tokens are never printed). Meant to be pasted to whoever
# builds the next Arvan feature (for instance a WAF rule that lets photo uploads through), so nothing is guessed.
cmd_arvan_probe() {
  need_root arvan-probe
  load_conf
  local key domain=${1:-${DOMAIN:-}} out
  key=$(secret_value ARVAN_API_KEY)
  [ -n "$key" ] || die "no Arvan key saved yet: sudo routeflow secrets set ARVAN_API_KEY"
  [ -n "$domain" ] || die "usage: routeflow arvan-probe [domain]"
  out="$CONF_DIR/arvan-probe.txt"
  ARVAN_API_KEY=$key python3 - "$domain" <<'PY' | tee "$out"
import json, os, re, sys, urllib.request, urllib.error
host = sys.argv[1].lower()
labels = host.split(".")
keep = 3 if len(labels) > 2 and labels[-2] in ("co", "ac", "gov", "org", "net", "sch", "id") and len(labels[-1]) == 2 else 2
root = ".".join(labels[-keep:])
base = os.environ.get("ARVAN_API_BASE", "https://napi.arvancloud.ir/cdn/4.0")
key = os.environ["ARVAN_API_KEY"]
SECRET = re.compile(r"key|token|secret|password|private|cert|ns_keys?$", re.I)
def shape(v, depth=0):
    if isinstance(v, dict):
        if depth >= 2: return "{%s}" % ",".join(list(v)[:12])
        return "{" + ", ".join("%s: %s" % (k, "<hidden>" if SECRET.search(k) else shape(x, depth + 1)) for k, x in list(v.items())[:14]) + ("…" if len(v) > 14 else "") + "}"
    if isinstance(v, list):
        return "[%d]" % len(v) + (" " + shape(v[0], depth + 1) if v else "")
    s = json.dumps(v, ensure_ascii=False)
    return s if len(s) <= 40 else s[:37] + "…"
def get(path):
    req = urllib.request.Request(base + path, headers={"Authorization": key if key.lower().startswith("apikey ") else "Apikey " + key, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        return e.code, e.read()
    except Exception as e:
        return 0, str(e).encode()
paths = ["/domains", "/domains/%s", "/domains/%s/dns-records", "/domains/%s/ssl", "/domains/%s/caching", "/domains/%s/waf",
  "/domains/%s/waf/rules", "/domains/%s/waf/exceptions", "/domains/%s/waf/whitelist", "/domains/%s/firewall", "/domains/%s/firewall/rules",
  "/domains/%s/page-rules", "/domains/%s/ddos", "/domains/%s/rate-limit", "/domains/%s/load-balancers", "/domains/%s/acceleration",
  "/domains/%s/https", "/domains/%s/upload-limit", "/domains/%s/security", "/domains/%s/settings", "/domains/%s/custom-pages",
  "/domains/%s/cname-setup", "/domains/%s/ssl/certificates", "/domains/%s/analytics", "/domains/%s/logs",
  "/swagger.json", "/openapi.json", "/docs"]
print("Arvan probe for %s (read-only, %d paths). Paste everything below." % (root, len(paths)))
for p in paths:
    path = p % root if "%s" in p else p
    code, body = get(path)
    try:
        j = json.loads(body)
        msg = shape(j.get("data", j)) if code == 200 else (j.get("message") or "")
    except Exception:
        msg = (body[:60].decode("utf-8", "replace") if code else body.decode("utf-8", "replace"))
    print("%3s GET %s  %s" % (code or "ERR", path, msg[:240]))
PY
  say "Saved in $out"
}

cmd_cdn_ips() {
  need_root cdn-ips
  load_conf
  local list n rule
  if [ "${1:-}" = --open ]; then
    ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null
    sed -i 's/^CDN_ONLY=.*/CDN_ONLY=0/' "$CONF"
    say "Web ports are open to everyone now and the weekly refresh leaves them so. Back to Arvan only: sudo routeflow cdn-ips --only"
    return 0
  fi
  if [ "${1:-}" = --only ]; then sed -i 's/^CDN_ONLY=.*/CDN_ONLY=1/' "$CONF"; CDN_ONLY=1; fi
  if [ "${CDN_ONLY:-1}" = 0 ]; then
    ufw allow 80/tcp >/dev/null; ufw allow 443/tcp >/dev/null
    say "Web ports open to everyone (CDN_ONLY=0)"; return 0
  fi
  list=$(curl -fsS --max-time 20 "$CDN_IPS_URL" 2>/dev/null | parse_cdn_ips || true)
  n=$(grep -c . <<<"$list" || true)
  [ "$n" -ge 5 ] || { warn "could not read Arvan's address list ($CDN_IPS_URL); firewall left as it was"; return 0; }
  # New ranges first (ufw skips ones it has), then remove open-to-all web rules and ranges Arvan
  # dropped, highest number first so the numbers do not shift: the site is never closed in between.
  while read -r net; do
    ufw allow proto tcp from "$net" to any port 80,443 comment routeflow-cdn >/dev/null
  done <<<"$list"
  for rule in $(ufw status numbered | stale_web_rules "$list" | sort -rn); do
    ufw --force delete "$rule" >/dev/null
  done
  say "Web ports open to Arvan's $n address ranges only"
}

write_cdn_timer() {
  cat >/etc/systemd/system/routeflow-cdn-ips.service <<UNIT
[Unit]
Description=RouteFlow: refresh the firewall from Arvan's address list
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/routeflow cdn-ips
UNIT
  cat >/etc/systemd/system/routeflow-cdn-ips.timer <<UNIT
[Unit]
Description=RouteFlow: refresh Arvan's address list weekly
[Timer]
OnCalendar=Sun *-*-* 05:00:00 Asia/Tehran
Persistent=true
[Install]
WantedBy=timers.target
UNIT
}

# D. The certificate Caddy uses toward Arvan. An origin certificate from the Arvan panel in
# $CONF_DIR/tls/ wins; CERT_MODE=internal uses Caddy's own (Arvan set to not check the origin);
# otherwise Let's Encrypt, which works through Arvan as long as plain HTTP reaches this server.
caddy_tls_line() {
  if [ -f "$CONF_DIR/tls/origin.crt" ] && [ -f "$CONF_DIR/tls/origin.key" ]; then
    echo "tls $CONF_DIR/tls/origin.crt $CONF_DIR/tls/origin.key"
  elif [ "${CERT_MODE:-auto}" = internal ]; then
    echo "tls internal"
  fi
}

# E. The pre-install checks and the status, any time.
# Hides anything that looks like a password, key or token, so the support file is safe to send.
redact() {
  sed -E 's/((PASS|PASSWORD|SECRET|TOKEN|KEY|APIKEY|CRED)[A-Z_]*=)[^[:space:]]*/\1***/gI; s#(postgres(ql)?://[^:/@]+:)[^@]+@#\1***@#g'
}

# One file with what a helper needs to see: versions, the doctor's answers, the logs. No secrets.
cmd_support_file() {
  need_root support-file
  load_conf
  local out=${1:-/root/routeflow-support-$(hostname)-$(date +%Y%m%d-%H%M).tar.gz} d
  d=$(mktemp -d)
  {
    echo "date: $(date -Is)"; echo "version: $(current_version)"; uname -a
    (. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME") || true
    free -m; df -h /; ufw status 2>&1 | head -40; systemctl --failed --no-pager 2>&1
  } 2>&1 | redact > "$d/system.txt"
  ( cmd_doctor ) 2>&1 | redact > "$d/doctor.txt" || true
  tail -n 2000 /var/log/routeflow-install.log 2>/dev/null | redact > "$d/install-log.txt" || true
  journalctl -u "$SERVICE" -n 300 --no-pager 2>&1 | redact > "$d/app-log.txt" || true
  journalctl -u caddy -n 100 --no-pager 2>&1 | redact > "$d/caddy-log.txt" || true
  redact < "$CONF" > "$d/routeflow.conf.txt" 2>/dev/null || true
  tar -czf "$out" -C "$d" .
  chmod 600 "$out"; rm -rf "$d"
  say "Support file: $out"
  echo "It holds logs and settings with passwords, keys and tokens hidden. Send it only to the person helping you."
}

# Takes the app off this server. The database, its backups, photos and the secrets stay.
cmd_uninstall() {
  need_root uninstall
  confirm UNINSTALL "This removes the app, its services and the Caddy site. The database, backups, photos and secrets stay."
  local f
  shopt -s nullglob
  for f in /etc/systemd/system/routeflow.service /etc/systemd/system/routeflow-{upgrade,cdn-ips,support-prune,storage-*}.{service,timer}; do
    systemctl disable --now "$(basename "$f")" >/dev/null 2>&1 || true
    rm -f "$f"
  done
  shopt -u nullglob
  systemctl daemon-reload
  rm -rf "$ROOT/releases" "$ROOT/current" "$ROOT/incoming"
  rm -f "$CADDY_DIR/sites/routeflow.caddy" "$CADDY_DIR/sites/routeflow-companies.caddy" /usr/local/bin/routeflow /etc/update-motd.d/90-routeflow "$CONF_DIR/install-steps"
  systemctl reload caddy 2>/dev/null || true
  say "The app is removed. Install again with a release file; the database and photos are still here."
  echo "To remove the database too, by hand: sudo -u postgres dropdb $DB_NAME"
}

cmd_doctor() {
  load_conf
  local problems
  problems=$(preflight)
  if [ -n "$problems" ]; then printf 'Problems:\n%s\n' "$problems"; else echo "Checks:    ok"; fi
  echo "Clock:     $(timedatectl show -p NTPSynchronized --value 2>/dev/null | sed 's/yes/in sync/;s/no/NOT in sync/')"
  echo "Firewall:  $(ufw status 2>/dev/null | grep -c routeflow-cdn) Arvan ranges allowed on 80/443"
  echo "Cert:      $(echo | timeout 5 openssl s_client -connect 127.0.0.1:443 -servername "$DOMAIN" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2 || echo unknown)"
  cmd_status
  [ -z "$problems" ]
}

# F. A few lines on every SSH login.
status_short() {
  local live health age=""
  live=$(current_version)
  if curl -fsS --max-time 2 "http://127.0.0.1:$(app_port)/api/health" >/dev/null 2>&1; then health=ok; else health="NOT ANSWERING"; fi
  if [ -f /var/lib/routeflow/backups/backup-status.json ]; then
    age=" | last backup $(( ($(date +%s) - $(date -r /var/lib/routeflow/backups/backup-status.json +%s)) / 3600 )) h ago"
  fi
