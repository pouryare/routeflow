# Copy to .env.local and fill in. Real values live in the private repo (routeflow-private), never here.
DATABASE_URL=postgres:///routeflow?host=/var/run/postgresql
SESSION_SECRET=change-me-to-48-random-characters
# Password every seeded demo login gets; leave empty and the seed makes a random one and prints it.
DEMO_PASSWORD=
# Contact address sent to Nominatim in the lead-import User-Agent.
CONTACT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
